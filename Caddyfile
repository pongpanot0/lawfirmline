# Reverse proxy with automatic HTTPS (Let's Encrypt) for the lawfirm app.
# {$DOMAIN} is read from the DOMAIN env var passed to the caddy service —
# set it in .env (see .env.production.example).
#
# DNS (once):
#   A  {$DOMAIN}           → EC2 IP
#   A  api.{$DOMAIN}       → EC2 IP
#   A  *.{$DOMAIN}         → EC2 IP   (all firm subdomains)
#
# All HTTPS names use On-Demand TLS. Caddy asks the API before serving/issuing
# a cert. The ask endpoint must allow:
#   - platform hosts: apex, www, api
#   - known firm slugs under ROOT_DOMAIN
# Otherwise `*.{$DOMAIN}` can steal SNI for api/www and return ERR_SSL_PROTOCOL_ERROR.
# The specific www redirect wins over the wildcard; keep on-demand TLS on both blocks.

{
	on_demand_tls {
		ask http://api:3001/saas/caddy-ask
	}
}

www.{$DOMAIN} {
	tls {
		on_demand
	}
	redir https://{$DOMAIN}{uri} 308
}

{$DOMAIN}, api.{$DOMAIN}, *.{$DOMAIN} {
	tls {
		on_demand
	}

	# Auto-upgrade any http:// subresource (images, API URLs stored in data)
	# so Chrome never flags the page as "not secure" over mixed content.
	header Content-Security-Policy "upgrade-insecure-requests"

	@firm {
		host *.{$DOMAIN}
		not host api.{$DOMAIN} www.{$DOMAIN}
	}
	header @firm >X-Robots-Tag "noindex, nofollow"

	@api host api.{$DOMAIN}
	handle @api {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}
