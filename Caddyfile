# Reverse proxy with automatic HTTPS (Let's Encrypt) for the lawfirm app.
# {$DOMAIN} is read from the DOMAIN env var passed to the caddy service —
# set it in .env (see .env.production.example).
#
# DNS (once):
#   A  {$DOMAIN}           → EC2 IP
#   A  api.{$DOMAIN}       → EC2 IP
#   A  *.{$DOMAIN}         → EC2 IP   (all firm subdomains)
#
# Platform hosts (apex, www, api) get ordinary managed certificates. Only firm
# subdomains use On-Demand TLS, which asks the API before serving/issuing a cert.
# Keeping the platform hosts off On-Demand means a slow or hung API can no longer
# stall the TLS handshake of the whole site (2026-10-25 outage: every host timed
# out while the ask endpoint hung). Exact host blocks win over the wildcard, so
# `*.{$DOMAIN}` cannot steal SNI for api/www.

{
	on_demand_tls {
		ask http://api:3001/saas/caddy-ask
	}
}

(common) {
	# Auto-upgrade any http:// subresource (images, API URLs stored in data)
	# so Chrome never flags the page as "not secure" over mixed content.
	header Content-Security-Policy "upgrade-insecure-requests"
}

{$DOMAIN}, www.{$DOMAIN} {
	import common
	reverse_proxy web:3000
}

api.{$DOMAIN} {
	import common
	reverse_proxy api:3001
}

*.{$DOMAIN} {
	tls {
		on_demand
	}
	import common
	reverse_proxy web:3000
}
