{
  "expo": {
    "name": "LexFlow",
    "slug": "lexflow-mobile",
    "version": "0.1.0",
    "scheme": "lexflow",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.lexflow.mobile"
    },
    "android": {
      "package": "co.lexflow.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
