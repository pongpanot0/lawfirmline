{
  "expo": {
    "name": "LexFlow",
    "slug": "lexflow-mobile",
    "version": "0.1.0",
    "scheme": "lexflow",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.lexflow.mobile"
    },
    "android": {
      "package": "co.lexflow.mobile"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
