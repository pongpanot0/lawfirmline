{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "build:prod": "prisma generate && nest build --path tsconfig.build.json",
    "dev": "pnpm --filter @lawfirm/shared build && prisma generate && nest start --watch --path tsconfig.build.json",
    "postinstall": "prisma generate",
    "start": "node dist/main",
    "start:prod": "prisma migrate deploy && node dist/main",
    "prisma": "prisma"
  },
  "dependencies": {
    "@lawfirm/shared": "workspace:*",
    "@nestjs/common": "^11.0.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.7",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.7",
    "@nestjs/schedule": "^5.0.1",
    "@prisma/client": "^6.3.1",
    "@sendgrid/mail": "^8.1.6",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "postgenerate": "node -e \"const fs=require('fs');const p='dist/generated/prisma';fs.mkdirSync('dist/generated',{recursive:true});fs.cpSync('src/generated/prisma',p,{recursive:true,force:true})\""
  }
}
