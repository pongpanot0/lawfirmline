  requirements    CargoDocumentRequirement[]

  @@index([firmId])
  @@index([playbookReleaseId])
}

model CargoDocumentRequirement {
  id           String           @id @default(uuid())
  cargoClaimId String
  code         String
  label        String
  required     Boolean          @default(false)
  status       DocRequestStatus @default(REQUESTED)
  note         String?
  documentId   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  cargoClaim CargoClaim @relation(fields: [cargoClaimId], references: [id], onDelete: Cascade)
  document   Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([cargoClaimId, code])
  @@index([cargoClaimId, status])
  @@index([documentId])
}

/// A system Document copied to OneDrive for editing in Word/Excel/PowerPoint online (M365 ส่วน D).
model DocumentOfficeLink {
  id              String   @id @default(uuid())
  documentId      String   @unique
  /// MailboxConnection whose token uploaded the copy and reads it back (no FK: connections are never deleted, only revoked).
  connectionId    String
  driveId         String
  itemId          String
  webUrl          String   @db.Text
  /// Document.version last uploaded to or pulled from OneDrive.
  uploadedVersion Int
  createdAt       DateTime @default(now())
  /// Last upload/pull; an item lastModifiedDateTime after this = Office edits not pulled back yet.
  updatedAt       DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([connectionId])
}

model DocumentVersion {
  id          String                @id @default(uuid())
  documentId  String
  version     Int
  storagePath String
  filename    String
  mimeType    String
  status      DocumentVersionStatus @default(DRAFT)
  notes       String?               @db.Text
  contentHash String?
  createdById String?
  createdAt   DateTime              @default(now())

  document     Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  publications DocumentPublication[]
  reviewRounds ReviewRound[]

  @@unique([documentId, version])
}

enum DocumentVersionStatus {
  DRAFT
  WAITING_REVIEW
  RETURNED_FOR_CHANGES
  APPROVED
  SUPERSEDED
}

model DocumentPublication {
  id                String    @id @default(uuid())
  documentId        String
  documentVersionId String
  publishedAt       DateTime  @default(now())
  publishedById     String
  unpublishedAt     DateTime?
  unpublishedById   String?
  title             String?
  summary           String?   @db.Text
  eventDate         DateTime?
  recipientContacts String[]  @default([])
  isInternal        Boolean   @default(false)

  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id])
  publishedBy     User            @relation("DocumentPublicationPublished", fields: [publishedById], references: [id])
  unpublishedBy   User?           @relation("DocumentPublicationUnpublished", fields: [unpublishedById], references: [id])

  @@index([documentId, publishedAt])
}

model CalendarEvent {
  id                 String          @id @default(uuid())
  caseId             String
  /// Who is attending. Reminders go to this person; without one they fall back
  /// to the case's lead lawyer rather than everyone staffed on the case.
  assigneeId         String?
  title              String
  description        String?
  courtName          String?
  startAt            DateTime
  endAt              DateTime?
  type               EventType       @default(OTHER)
  /// ใช้เฉพาะ type = COURT_DATE — กฎวันครบกำหนดบางข้อเลือกนัดตามชนิด
  courtEventKind     CourtEventKind?
  reminderMinutes    Int[]           @default([4320, 1440, 60])
  travelLogId        String?
  /// Client meetings only: a Teams link is created through the organizer's Outlook.
  onlineMeeting      Boolean         @default(false)
  onlineMeetingUrl   String?
  meetingOrganizerId String?
  inviteeEmails      String[]        @default([])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  meetingOrganizer   User?                        @relation("EventMeetingOrganizer", fields: [meetingOrganizerId], references: [id], onDelete: SetNull)
  case               Case                         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignee           User?                        @relation("EventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  travelLog          TravelLog?                   @relation(fields: [travelLogId], references: [id])
  reminderLogs       ReminderLog[]
  dateSuggestion     DocumentDateSuggestion?
  triggeredDeadlines DocumentDateSuggestion[]     @relation("DateSuggestionTrigger")
  expenses           Expense[]
  responsibility     EventResponsibility?
  courtDay           CourtDay?
  assignees          CalendarEventAssignee[]
  outlookChanges     CalendarEventOutlookChange[]

  @@index([startAt])
  @@index([assigneeId])
}

model CalendarEventAssignee {
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation("EventCoAssignee", fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

/// Our event mirrored into one person's Outlook calendar. eventId has no FK on
/// purpose: after the event (or its case) is deleted we still need graphEventId
/// to remove the Outlook copy.
model CalendarEventOutlookCopy {
  id                 String    @id @default(uuid())
  eventId            String
  userId             String
  connectionId       String
  graphEventId       String
  syncedAt           DateTime
  lastError          String?   @db.Text
  /// Deleted/cancelled by the owner in Outlook — sync must never recreate it.
  removedInOutlookAt DateTime?

  @@unique([eventId, userId])
  @@index([connectionId])
  @@index([userId])
}

/// A move made in Outlook that is waiting for someone to apply or keep it.
model CalendarEventOutlookChange {
  id              String    @id @default(uuid())
  eventId         String
  userId          String
  copyId          String
  proposedStartAt DateTime
  proposedEndAt   DateTime?
  detectedAt      DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  /// APPLIED | KEPT
  resolution      String?

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, resolvedAt])
}

model EmailTemplate {
  id          String   @id @default(uuid())
  firmId      String
  name        String
  subject     String
  body        String   @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm      Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  createdBy User? @relation("EmailTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([firmId])
}

model LeaveRequest {
  id          String      @id @default(uuid())
  firmId      String
  userId      String
  type        LeaveType
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  status      LeaveStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime    @default(now())

  firm      Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user      User  @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([firmId, userId, startDate, endDate])
  @@index([firmId, startDate, endDate])
  @@index([userId, startDate])
}

model LeaveNoticeLog {
  key       String    @id
  claimedAt DateTime  @default(now())
  sentAt    DateTime?
}

model ReminderLog {
  id            String   @id @default(uuid())
  eventId       String
  sentAt        DateTime @default(now())
  channel       String   @default("console")
  minutesBefore Int

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, minutesBefore])
}

model TimeEntry {
  id             String    @id @default(uuid())
  caseId         String
  userId         String
  hours          Float
  rate           Float     @default(0)
  description    String?
  date           DateTime  @default(now())
  billable       Boolean   @default(true)
  /// ใบแจ้งหนี้ที่เก็บเงินรายการนี้ไปแล้ว — กันออกบิลซ้ำ
  invoiceId      String?
  /// คีย์กันซ้ำสำหรับรายการที่สร้างจากแหล่งอัตโนมัติ (เช่น ร่างเวลาจากปฏิทิน)
  sourceKey      String?
  /// ตัดเป็นค่าเสียหายของสำนักงาน (write-off) — ไม่เรียกเก็บลูกค้า
  writtenOffAt   DateTime?
  writtenOffById String?
  writeOffReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  writtenOffBy User?    @relation("TimeEntryWriteOff", fields: [writtenOffById], references: [id], onDelete: SetNull)

  @@unique([userId, sourceKey])
  @@index([invoiceId])
}

model Expense {
  id                 String        @id @default(uuid())
  caseId             String?
  userId             String
  /// Set when this line is part of a submitted claim round.
  claimId            String?
  amount             Float
  description        String
  category           String?
  expensePurpose     String?
  status             ExpenseStatus @default(PENDING)
  date               DateTime      @default(now())
  /// The hearing this cost came from, when it was drafted off one — so a
  /// reimbursement can be traced back to the trip that caused it.
  sourceEventId      String?
  paidAt             DateTime?
  paidById           String?
  /// Set when this cost was covered out of a cash advance the owner already
  /// handed the claimant — the expense is recorded straight as PAID and never
  /// enters an ExpenseClaim, since there is nothing left to reimburse.
  paidFromAdvanceId  String?
  /// Optional receipt photo uploaded with the claim.
  receiptFilename    String?
  /// false = สำนักงานออกเอง ไม่ผลักไปเก็บกับลูกค้า
  billable           Boolean       @default(true)
  /// ใบแจ้งหนี้ที่เก็บเงินรายการนี้ไปแล้ว — กันออกบิลซ้ำ
  invoiceId          String?
  receiptStoragePath String?
  receiptMimeType    String?
  /// เลขที่ใบเสร็จรับเงินทางการ (เช่น ค่าธรรมเนียมศาล)
  officialReceiptNo  String?
  writtenOffAt       DateTime?
  writtenOffById     String?
  writeOffReason     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  writtenOffBy    User?          @relation("ExpenseWriteOff", fields: [writtenOffById], references: [id], onDelete: SetNull)
  case            Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  user            User           @relation(fields: [userId], references: [id])
  paidBy          User?          @relation("ExpensePaidBy", fields: [paidById], references: [id])
  sourceEvent     CalendarEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  claim           ExpenseClaim?  @relation(fields: [claimId], references: [id], onDelete: SetNull)
  paidFromAdvance CashAdvance?   @relation(fields: [paidFromAdvanceId], references: [id], onDelete: SetNull)

  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([sourceEventId])
  @@index([claimId])
  @@index([paidFromAdvanceId])
  @@index([invoiceId])
}

/// One reimbursement round: lawyer submits many draft lines; owner approves the batch.
model ExpenseClaim {
  id            String             @id @default(uuid())
  firmId        String
  submittedById String
  status        ExpenseClaimStatus @default(PENDING)
  submittedAt   DateTime           @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  paidAt        DateTime?
  paidById      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  firm        Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  submittedBy User      @relation("ExpenseClaimSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?     @relation("ExpenseClaimReviewer", fields: [reviewedById], references: [id])
  paidBy      User?     @relation("ExpenseClaimPayer", fields: [paidById], references: [id])
  expenses    Expense[]

  @@index([firmId, status])
  @@index([submittedById])
}

model PettyCashFund {
  id        String   @id @default(uuid())
  firmId    String   @unique
  balance   Float    @default(50000)
  updatedAt DateTime @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
}

/// A cash float the owner hands a lawyer/staff member up front (เงินยืมสำรองจ่าย)
/// so they can cover case costs without waiting on reimbursement. `remaining`
/// is drawn down as expenses are logged against it via Expense.paidFromAdvanceId —
/// those expenses skip the normal claim → approve → reimburse cycle since the
/// cash already changed hands.
model CashAdvance {
  id             String    @id @default(uuid())
  firmId         String
  userId         String
  amount         Float
  remaining      Float
  note           String?
  issuedById     String
  issuedAt       DateTime  @default(now())
  /// ปิดเงินสดทดรองจ่าย — เมื่อรับเงินที่เหลือคืนแล้ว
  settledAt      DateTime?
  settledById    String?
  returnedAmount Float     @default(0)
  settlementNote String?
  createdAt      DateTime  @default(now())

  firm      Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user      User      @relation("CashAdvanceRecipient", fields: [userId], references: [id])
  issuedBy  User      @relation("CashAdvanceIssuer", fields: [issuedById], references: [id])
  settledBy User?     @relation("CashAdvanceSettler", fields: [settledById], references: [id], onDelete: SetNull)
  expenses  Expense[]

  @@index([firmId, userId])
}

model TravelLog {
  id              String   @id @default(uuid())
  origin          String
  destination     String
  distanceMeters  Int
  durationSeconds Int
  mapsUrl         String?
  createdAt       DateTime @default(now())

  calendarEvents CalendarEvent[]

  @@index([origin, destination, createdAt])
}

model CaseKnowledge {
  id           String            @id @default(uuid())
  caseId       String
  documentId   String?
  title        String
  summary      String            @db.Text
  category     KnowledgeCategory @default(SUMMARY)
  createdById  String
  createdAt    DateTime          @default(now())
  /// Set once a lawyer has checked the citations against the source and
  /// confirmed the summary is accurate — never set by the analysis itself.
  reviewedById String?
  reviewedAt   DateTime?
  /// Contradictions or gaps the AI noticed in the source documents, e.g.
  /// [{ "type": "CONFLICT" | "MISSING", "description": "..." }]. Advisory
  /// only — never blocks saving or reading the analysis.
  flags        Json?

  case       Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document   Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy  User                @relation("CaseKnowledgeCreator", fields: [createdById], references: [id])
  reviewedBy User?               @relation("CaseKnowledgeReviewer", fields: [reviewedById], references: [id])
  citations  KnowledgeCitation[]
}

/// A single fact from an AI analysis, pinned to the exact document, version
/// and (when available) page it came from, with the verbatim sentence it was
/// read from. Only ever created after the quote is confirmed to appear in the
/// extracted document text — a citation that cannot be found in the source is
/// dropped rather than stored, so every row here is checkable by a lawyer.
model KnowledgeCitation {
  id              String   @id @default(uuid())
  knowledgeId     String
  documentId      String
  documentVersion Int
  page            Int?
  /// The fact in the lawyer's own reading order, e.g. "ค่าเสียหายที่เรียกร้อง 500,000 บาท".
  statement       String   @db.Text
  /// The verbatim sentence `statement` was read from — always checked to
  /// appear in the extracted document text before this row is created.
  quote           String   @db.Text
  createdAt       DateTime @default(now())

  knowledge CaseKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  document  Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([knowledgeId])
}

model DocumentDateSuggestion {
  id              String               @id @default(uuid())
  caseId          String
  documentId      String?
  label           String
  suggestedDate   DateTime
  eventType       EventType            @default(DEADLINE)
  /// Only present for DOCUMENT suggestions — a rule-derived date has no quote.
  sourceExcerpt   String?              @db.Text
  source          DateSuggestionSource @default(DOCUMENT)
  /// For RULE suggestions: the rule and the event that started the clock.
  deadlineRuleId  String?
  triggerEventId  String?
  /// For EMAIL suggestions: the case email the date was read from.
  emailMessageId  String?
  status          DateSuggestionStatus @default(PENDING)
  calendarEventId String?              @unique
  createdById     String
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  case          Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  emailMessage  EmailMessage?  @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("DateSuggestionCreator", fields: [createdById], references: [id])
  reviewedBy    User?          @relation("DateSuggestionReviewer", fields: [reviewedById], references: [id])
  deadlineRule  DeadlineRule?  @relation(fields: [deadlineRuleId], references: [id], onDelete: SetNull)
  triggerEvent  CalendarEvent? @relation("DateSuggestionTrigger", fields: [triggerEventId], references: [id], onDelete: Cascade)

  @@unique([triggerEventId, deadlineRuleId])
  @@index([caseId, status])
  @@index([emailMessageId])
}

/// Platform-wide procedural clock: "<offsetDays> days from <trigger>".
/// Rules never write to the calendar directly — they raise a
/// DocumentDateSuggestion for a lawyer to confirm.
/// caseTypeId is reserved for a future catalog; this pass keeps it null.
model DeadlineRule {
  id             String           @id @default(uuid())
  /// null = ค่าตั้งต้นส่วนกลาง; มีค่า = กฎของสำนักงาน (ทับกฎกลางที่ trigger + label ตรงกัน)
  firmId         String?
  caseTypeId     String?
  trigger        DeadlineTrigger
  label          String
  /// จำนวนวัน (หรือเดือนเมื่อ dayBasis = MONTHS); ติดลบ = ก่อนเหตุตั้งต้น
  offsetDays     Int
  dayBasis       DeadlineDayBasis @default(CALENDAR)
  /// บวก/ลบวันตามปฏิทินหลังนับ offset แล้ว เช่น 10 ปี − 90 วัน
  adjustDays     Int              @default(0)
  courtEventKind CourtEventKind?
  courtLevel     CourtLevel?
  partySide      PartyRole?
  serviceMethod  ServiceMethod?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  firm        Firm?                    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  caseType    CaseType?                @relation(fields: [caseTypeId], references: [id], onDelete: Cascade)
  suggestions DocumentDateSuggestion[]

  @@index([trigger, isActive])
  @@index([firmId, trigger])
}

/// Thai public holidays, used when a rule counts business days.
model PublicHoliday {
  id   String   @id @default(uuid())
  date DateTime @db.Date
  name String

  @@unique([date])
}

/// One row per user per Bangkok day, so a digest is never sent twice.
model DailyDigestLog {
  id         String   @id @default(uuid())
  userId     String
  /// The Bangkok calendar day the digest covered.
  digestDate DateTime @db.Date
  channel    String   @default("line")
  itemCount  Int      @default(0)
  sentAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, digestDate, channel])
}

model DocumentTemplate {
  id           String   @id @default(uuid())
  /// null = built-in template ที่ทุก firm ใช้ได้; มีค่า = template ของ firm นั้นเท่านั้น
  firmId       String?
  name         String
  description  String?
  templateBody String   @db.Text
  caseTypeId   String?
  createdAt    DateTime @default(now())

  caseType CaseType? @relation(fields: [caseTypeId], references: [id], onDelete: SetNull)

  @@index([firmId])
}

model Invoice {
  id                String        @id @default(uuid())
  firmId            String
  /// ใบแจ้งหนี้ออกได้โดยไม่มีคดี — จากเรื่องที่รับเข้ามา หรือออกเปล่าให้ลูกค้าดูก่อน
  caseId            String?
  intakeId          String?
  invoiceNumber     String        @unique
  status            InvoiceStatus @default(DRAFT)
  totalAmount       Float         @default(0)
  /// ส่วนลดทั้งใบ — totalAmount คือยอดหลังหักส่วนลดแล้ว
  discountAmount    Float         @default(0)
  discountReason    String?
  /// ใบที่แยกจากการออกบิลชุดเดียวกัน (เช่น แบ่งตามลูกค้า)
  splitGroupId      String?
  issuedAt          DateTime?
  dueAt             DateTime?
  /// เวลาที่ส่งการแจ้งเตือนทวงเงินครั้งล่าสุด — กันแจ้งซ้ำถี่เกินไป
  lastReminderAt    DateTime?
  collectionOwnerId String?
  collectionNextAt  DateTime?     @db.Date
  collectionNote    String?       @db.Text
  createdById       String
  billToCustomerId  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  firm            Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case            Case?             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  intake          Intake?           @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("InvoiceCreator", fields: [createdById], references: [id])
  collectionOwner User?             @relation("InvoiceCollector", fields: [collectionOwnerId], references: [id], onDelete: SetNull)
  timeEntries     TimeEntry[]
  expenses        Expense[]
  billToCustomer  Client?           @relation("InvoiceBillTo", fields: [billToCustomerId], references: [id], onDelete: SetNull)
  lineItems       InvoiceLineItem[]
  payments        InvoicePayment[]

  @@index([firmId])
  @@index([caseId])
  @@index([intakeId])
  @@index([billToCustomerId])
  @@index([firmId, collectionNextAt])
  @@index([firmId, splitGroupId])
}

model InvoicePayment {
  id              String        @id @default(uuid())
  firmId          String
  invoiceId       String
  amount          Float
  method          PaymentMethod @default(TRANSFER)
  receivedAt      DateTime      @db.Date
  note            String?
  recordedById    String
  createdAt       DateTime      @default(now())
  createRequestId String?

  firm       Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("InvoicePaymentRecorder", fields: [recordedById], references: [id])

  @@unique([firmId, createRequestId])
  @@index([invoiceId])
  @@index([firmId, receivedAt])
}

/// ลูกค้า (ผู้ว่าจ้าง/ผู้จ่ายเงิน) ของคดี — ต่างจาก Case.clientId ซึ่งคือลูกความที่เราว่าความให้
model CaseCustomer {
  id           String   @id @default(uuid())
  caseId       String
  customerId   String
  sharePercent Float?
  isPrimary    Boolean  @default(false)
  note         String?
  /// คนติดต่อฝั่งลูกค้ารายนี้ — ใครคือคนที่คุยกับเรา
  contactId    String?
  createdAt    DateTime @default(now())

  case     Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  customer Client         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  ClientContact? @relation("CaseCustomerContact", fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([caseId, customerId])
  @@index([customerId])
}

/// ลูกค้า (ผู้ว่าจ้าง/ผู้จ่ายเงิน) ของเรื่องที่รับเข้ามา — คัดลอกไป CaseCustomer ตอนแปลงเป็นคดี
model IntakeCustomer {
  id           String   @id @default(uuid())
  intakeId     String
  customerId   String
  sharePercent Float?
  isPrimary    Boolean  @default(false)
  note         String?
  /// คนติดต่อฝั่งลูกค้ารายนี้ — ติดไป CaseCustomer.contactId ตอนเปิดคดี
  contactId    String?
  createdAt    DateTime @default(now())

  intake   Intake         @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  customer Client         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  ClientContact? @relation("IntakeCustomerContact", fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([intakeId, customerId])
  @@index([customerId])
}

/// ลูกความเพิ่มเติมของคดี (เกินคนที่ 1) — Case.clientId ยังเป็นลูกความหลักเหมือนเดิม
model CaseClient {
  id        String   @id @default(uuid())
  caseId    String
  clientId  String
  note      String?
  createdAt DateTime @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([caseId, clientId])
  @@index([clientId])
}

/// ลูกความเพิ่มเติมของเรื่องที่รับเข้ามา — คัดลอกไป CaseClient ตอนแปลงเป็นคดี
model IntakeClient {
  id        String   @id @default(uuid())
  intakeId  String
  clientId  String
  note      String?
  createdAt DateTime @default(now())

  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([intakeId, clientId])
  @@index([clientId])
}

model InvoiceLineItem {
  id          String @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float  @default(1)
  unitPrice   Float
  amount      Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ClosingEmailDraft {
  id                  String                    @id @default(uuid())
  caseId              String
  createdById         String
  subject             String
  bodyText            String                    @db.Text
  selectedActivityIds String[]                  @default([])
  missingDataNotes    String[]                  @default([])
  recipientKind       ClosingEmailRecipientKind @default(CLIENT)
  recipientClientId   String?
  status              ClosingEmailDraftStatus   @default(DRAFT)
  approvedById        String?
  approvedAt          DateTime?
  sentAt              DateTime?
  /// Email addresses the approved draft was actually delivered to.
  sentTo              String[]                  @default([])
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  case            Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy       User    @relation("ClosingEmailDraftCreator", fields: [createdById], references: [id])
  approvedBy      User?   @relation("ClosingEmailDraftApprover", fields: [approvedById], references: [id])
  recipientClient Client? @relation("ClosingDraftRecipient", fields: [recipientClientId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([recipientClientId])
}

model InsuranceClaim {
  id                   String              @id @default(uuid())
  caseId               String              @unique
  insurerName          String
  policyNumber         String?
  claimNumber          String?
  incidentDate         DateTime
  claimedDate          DateTime?
  denialReason         String?             @db.Text
  stage                InsuranceClaimStage @default(CLAIM_FILED)
  demandLetterSentAt   DateTime?
  demandLetterDeadline DateTime?
  oicComplaintNumber   String?
  oicComplaintDate     DateTime?
  oicOutcome           String?             @db.Text
  limitationEventId    String?
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([caseId])
}

enum OnHoldCategory {
  WAITING_CLIENT
  WAITING_COURT
  WAITING_DOCUMENT
  WAITING_INTERNAL_REVIEW
  WAITING_EXTERNAL
  OTHER
}

model TaskOnHold {
  id             String         @id @default(uuid())
  taskId         String         @unique
  category       OnHoldCategory @default(OTHER)
  reason         String         @db.Text
  startedAt      DateTime       @default(now())
  endedAt        DateTime?
  followerUserId String?
  lastFollowUpAt DateTime?
  nextFollowUpAt DateTime?
  notes          String?        @db.Text
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  follower  User? @relation("TaskOnHoldFollower", fields: [followerUserId], references: [id])
  createdBy User  @relation("TaskOnHoldCreator", fields: [createdById], references: [id])

  @@index([nextFollowUpAt])
  @@index([endedAt])
}

model PortalIntakeSubmission {
  accessContactIds          String[]               @default([])
  revokedContactIds         String[]               @default([])
  officeOwnerId             String?
  scopeText                 String?
  proposedDate              DateTime?
  agreedDate                DateTime?
  commitmentVersion         Int                    @default(0)
  acceptedCommitmentVersion Int?
  agreementAcceptedAt       DateTime?
  deliveredAt               DateTime?
  deliveryAcknowledgedAt    DateTime?
  messages                  PortalRequestMessage[]
  id                        String                 @id @default(uuid())
  clientId                  String
  clientContactId           String
  referenceNumber           String                 @unique
  title                     String
  detail                    String                 @db.Text
  clientRequestedDate       DateTime?
  urgencyFlag               Boolean                @default(false)
  submittedAt               DateTime               @default(now())
  withdrawnByClient         Boolean                @default(false)
  withdrawnAt               DateTime?
  withdrawnReason           String?
  intakeId                  String?                @unique
  caseId                    String?                @unique
  createdAt                 DateTime               @default(now())

  client        Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientContact ClientContact            @relation(fields: [clientContactId], references: [id], onDelete: Cascade)
  intake        Intake?                  @relation(fields: [intakeId], references: [id])
  case          Case?                    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  attachments   PortalIntakeAttachment[]

  @@index([clientId, submittedAt])
  @@index([clientContactId, submittedAt])
  @@index([withdrawnByClient])
}

model PortalIntakeAttachment {
  id                       String   @id @default(uuid())
  portalIntakeSubmissionId String
  filename                 String
  storagePath              String
  mimeType                 String
  size                     Int
  createdAt                DateTime @default(now())

  submission PortalIntakeSubmission @relation(fields: [portalIntakeSubmissionId], references: [id], onDelete: Cascade)

  @@index([portalIntakeSubmissionId])
}

model ClientPortalInvite {
  id              String    @id @default(uuid())
  clientContactId String
  token           String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedById     String
  createdAt       DateTime  @default(now())

  clientContact ClientContact @relation(fields: [clientContactId], references: [id], onDelete: Cascade)
  invitedBy     User          @relation("SentPortalInvitations", fields: [invitedById], references: [id])

  @@index([clientContactId])
}

model ContactCaseAccess {
  id              String    @id @default(uuid())
  clientContactId String
  caseId          String
  grantedAt       DateTime  @default(now())
  startDate       DateTime  @default(now())
  endDate         DateTime?
  grantedById     String
  revokedAt       DateTime?
  revokedById     String?
  notes           String?

  clientContact ClientContact @relation(fields: [clientContactId], references: [id], onDelete: Cascade)
  case          Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  grantedBy     User          @relation("ContactCaseAccessGranted", fields: [grantedById], references: [id])
  revokedBy     User?         @relation("ContactCaseAccessRevoked", fields: [revokedById], references: [id])

  @@unique([clientContactId, caseId])
  @@index([clientContactId])
  @@index([startDate, endDate])
}

model CaseMessage {
  id              String            @id @default(uuid())
  caseId          String
  senderType      MessageSenderType
  senderUserId    String?
  senderContactId String?
  body            String            @db.Text
  /// ไฟล์ที่แนบมากับข้อความ — ลูกความส่งเอกสารเพิ่มเข้ามาได้ในสายเดียวกัน
  filename        String?
  storagePath     String?
  mimeType        String?
  size            Int?
  createdAt       DateTime          @default(now())

  case          Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  senderUser    User?          @relation(fields: [senderUserId], references: [id])
  senderContact ClientContact? @relation(fields: [senderContactId], references: [id])

  @@index([caseId, createdAt])
}

model ContactNotificationPreference {
  id              String              @id @default(uuid())
  clientContactId String
  channel         NotificationChannel
  isEnabled       Boolean             @default(true)

  clientContact ClientContact @relation(fields: [clientContactId], references: [id], onDelete: Cascade)

  @@unique([clientContactId, channel])
}

// --- Email intake (mock-provider adapter) ---

enum EmailThreadStatus {
  PENDING_INTAKE
  LINKED
  ARCHIVED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum FieldProposalSourceType {
  EMAIL_BODY
  ATTACHMENT
  EXISTING_CLIENT
  MANUAL
}

enum FieldProposalStatus {
  SUGGESTED
  REQUIRES_CONFIRMATION
  CONFIRMED
  REJECTED
  CONFLICT
}

model EmailThread {
  id            String            @id @default(uuid())
  firmId        String
  provider      String            @default("mock")
  threadKey     String
  subject       String
  fromName      String?
  fromAddress   String?
  lastMessageAt DateTime          @default(now())
  intakeId      String?
  status        EmailThreadStatus @default(PENDING_INTAKE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  mailboxConnectionId    String?
  caseId                 String?
  /// Set when a person manually unlinks the thread from a case; sync must not re-link it.
  caseUnlinkedAt         DateTime?
  /// Someone marked "no reply needed"; only counts if after the latest inbound message.
  replyDismissedAt       DateTime?
  /// Inbound EmailMessage.id we last sent a reply reminder for (one reminder per inbound message).
  replyReminderMessageId String?

  firm              Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  intake            Intake?            @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  messages          EmailMessage[]
  mailboxConnection MailboxConnection? @relation(fields: [mailboxConnectionId], references: [id], onDelete: SetNull)
  case              Case?              @relation("CaseEmailThreads", fields: [caseId], references: [id], onDelete: SetNull)

  @@unique([firmId, provider, threadKey])
  @@index([firmId])
  @@index([intakeId])
  @@index([mailboxConnectionId])
  @@index([caseId])
  @@index([caseId, lastMessageAt])
}

model EmailMessage {
  id          String         @id @default(uuid())
  threadId    String
  provider    String         @default("mock")
  messageKey  String
  direction   EmailDirection @default(INBOUND)
  fromName    String?
  fromAddress String?
  bodyText    String?        @db.Text
  receivedAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  graphMessageId String?
  toAddresses    String[] @default([])
  ccAddresses    String[] @default([])
  bodyHtml       String?  @db.Text

  thread          EmailThread              @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments     EmailAttachment[]
  fieldProposals  IntakeFieldProposal[]
  dateSuggestions DocumentDateSuggestion[]

  @@unique([threadId, messageKey])
  @@index([threadId])
}

model EmailAttachment {
  id          String   @id @default(uuid())
  messageId   String
  filename    String
  storagePath String
  mimeType    String
  contentHash String?
  createdAt   DateTime @default(now())

  message EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model IntakeFieldProposal {
  id                   String                  @id @default(uuid())
  intakeId             String
  field                String
  proposedValue        String?                 @db.Text
  previousValue        String?                 @db.Text
  sourceType           FieldProposalSourceType @default(EMAIL_BODY)
  sourceDetail         String?
  sourceEmailMessageId String?
  status               FieldProposalStatus     @default(SUGGESTED)
  confirmedById        String?
  confirmedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  intake             Intake        @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  sourceEmailMessage EmailMessage? @relation(fields: [sourceEmailMessageId], references: [id], onDelete: SetNull)

  @@index([intakeId])
  @@index([sourceEmailMessageId])
}

// --- Document review rounds ---

enum ReviewApprovalRule {
  ALL
  ANY_ONE
}

enum ReviewRoundStatus {
  WAITING_REVIEW
  RETURNED
  APPROVED
  CANCELLED
}

enum ReviewDecisionType {
  APPROVED
  RETURNED
}

model ReviewRound {
  id                String             @id @default(uuid())
  documentVersionId String
  reviewerIds       String[]           @default([])
  editorIds         String[]           @default([])
  approvalRule      ReviewApprovalRule @default(ALL)
  scope             String?
  dueAt             DateTime?
  /// Set once the "due tomorrow" reminder went out, so a restart never sends it twice.
  dueReminderSentAt DateTime?
  status            ReviewRoundStatus  @default(WAITING_REVIEW)
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  documentVersion DocumentVersion  @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  decisions       ReviewDecision[]

  @@index([documentVersionId])
}

model ReviewDecision {
  id            String             @id @default(uuid())
  reviewRoundId String
  reviewerId    String
  decision      ReviewDecisionType
  reason        String?            @db.Text
  decidedAt     DateTime           @default(now())

  reviewRound ReviewRound @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)

  @@unique([reviewRoundId, reviewerId])
  @@index([reviewRoundId])
}

// --- Outlook / Microsoft Graph mailbox connections (self-service OAuth) ---

enum MailboxConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

model MailboxConnection {
  id                     String                  @id @default(uuid())
  firmId                 String
  mailboxAddress         String
  connectedByUserId      String
  provider               String                  @default("microsoft")
  accessTokenEnc         String                  @db.Text
  refreshTokenEnc        String                  @db.Text
  tokenExpiresAt         DateTime
  webhookSecret          String
  graphSubscriptionId    String?
  subscriptionExpiresAt  DateTime?
  deltaLink              String?                 @db.Text
  status                 MailboxConnectionStatus @default(ACTIVE)
  lastError              String?                 @db.Text
  lastSyncedAt           DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  userId                 String?
  syncInboxToIntake      Boolean                 @default(false)
  syncCalendar           Boolean                 @default(true)
  sentDeltaLink          String?                 @db.Text
  calendarDeltaLink      String?                 @db.Text
  calendarDeltaStartedAt DateTime?

  caseExternalLinks CaseExternalLink[]
  firm              Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user              User?              @relation("MailboxConnectionOwner", fields: [userId], references: [id], onDelete: SetNull)
  threads           EmailThread[]

  @@unique([firmId, mailboxAddress])
  @@index([firmId])
  @@index([graphSubscriptionId])
  @@index([userId])
}

enum CaseExternalLinkKind {
  OUTLOOK_FOLDER
  DRIVE_FOLDER
}

/// folder ภายนอก (Outlook mail folder / OneDrive-SharePoint folder) ที่ผูกกับคดี — ซิงก์ด้วย token ของ connection ที่ผูก
model CaseExternalLink {
  id           String               @id @default(uuid())
  firmId       String
  caseId       String
  connectionId String
  kind         CaseExternalLinkKind
  /// mailFolder id | driveItem id
  externalId   String
  driveId      String?
  displayPath  String
  deltaLink    String?              @db.Text
  linkedById   String
  lastSyncedAt DateTime?
  lastError    String?              @db.Text
  createdAt    DateTime             @default(now())

  case       Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  connection MailboxConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, kind, externalId])
  @@index([caseId])
}

/// Shared preparation and a single, retry-safe outcome for one court appointment.
model CourtDay {
  eventId     String        @id
  version     Int           @default(0)
  state       Json
  result      Json?
  completedAt DateTime?
  updatedById String
  updatedAt   DateTime      @updatedAt
  event       CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

/// Acknowledgement is valid only for the event revision and responsible lawyer recorded here.
model EventResponsibility {
  eventId        String        @id
  eventUpdatedAt DateTime
  ownerId        String
  acceptedAt     DateTime?
  completedAt    DateTime?
  updatedAt      DateTime      @updatedAt
  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model PortalRequestMessage {
  id           String                 @id @default(uuid())
  submissionId String
  requestKey   String
  contentHash  String
  authorId     String
  authorKind   String
  body         String                 @db.Text
  filename     String?
  storagePath  String?
  mimeType     String?
  size         Int?
  createdAt    DateTime               @default(now())
  submission   PortalIntakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, authorId, requestKey])
  @@index([submissionId, createdAt])
}

model AutomationLog {
  id         String   @id @default(uuid())
  firmId     String
  automation String
  trigger    Json?
  result     Json?
  success    Boolean  @default(true)
  error      String?
  createdAt  DateTime @default(now())

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt])
}

model Sop {
  id          String   @id @default(uuid())
  firmId      String
  title       String
  content     String   @db.Text
  category    String?
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm      Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  updatedBy User @relation(fields: [updatedById], references: [id])

  @@index([firmId])
}

model CaseStatusLog {
  id          String     @id @default(uuid())
  caseId      String
  fromStatus  CaseStatus
  toStatus    CaseStatus
  /// มีค่าเมื่อแถวนี้บันทึกการย้ายขั้นตอนคดี (fromStatus = toStatus เมื่อสถานะไม่เปลี่ยน)
  fromStage   CaseStage?
  toStage     CaseStage?
  note        String?
  changedById String
  createdAt   DateTime   @default(now())

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([caseId, createdAt])
}

model PlaybookRelease {
  id            String            @id @default(uuid())
  firmId        String
  name          String
  workType      String
  /// ผูกกับประเภทคดี — apply อัตโนมัติ/แนะนำเมื่อเปิดคดีประเภทนี้
  caseTypeId    String?
  /// Stable identity for a reusable system/domain playbook across versions.
  templateKey   String?
  /// Versioned Cargo document matrix. Matters snapshot this into CargoDocumentRequirement.
  cargoTemplate Json?
  version       Int
  steps         Json
  publishedById String
  createdAt     DateTime          @default(now())
  firm          Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  applications  AppliedPlaybook[]
  cargoClaims   CargoClaim[]

  @@unique([firmId, name, version])
  @@index([firmId, templateKey, version])
}

model AppliedPlaybook {
  id          String          @id @default(uuid())
  caseId      String
  releaseId   String
  taskIds     String[]        @default([])
  appliedById String
  startDate   DateTime
  createdAt   DateTime        @default(now())
  case        Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  release     PlaybookRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@unique([caseId, releaseId])
}

model DataImportBatch {
  id          String    @id @default(uuid())
  firmId      String
  createdById String
  rows        Json
  ledger      Json?
  status      String    @default("PREVIEW")
  createdAt   DateTime  @default(now())
  committedAt DateTime?
  undoneAt    DateTime?
  firm        Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt])
}

/// A page-anchored slice of an extracted document, embedded for RAG retrieval.
/// Content is stored AFTER redactForAi(), so it is safe to send to the model.
model DocumentChunk {
  id              String                       @id @default(uuid())
  caseId          String
  documentId      String
  documentVersion Int                          @default(1)
  chunkIndex      Int
  pageStart       Int?
  pageEnd         Int?
  content         String                       @db.Text
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                     @default(now())

  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([caseId])
}

/// One outbound AI model call — for cost/usage accounting per firm/case.
model AiRun {
  id           String   @id @default(uuid())
  provider     String   @default("openai")
  model        String
  operation    String
  firmId       String?
  caseId       String?
  documentId   String?
  userId       String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  status       String   @default("success")
  createdAt    DateTime @default(now())

  @@index([firmId, createdAt])
  @@index([caseId, createdAt])
}

/// One "ถามกฎหมายไทย" run: selected verified facts + question → iApp deka
/// search. Stored separately from facts (LEGAL is never a FACT — spec §2).
model LegalQuery {
  id          String   @id @default(uuid())
  caseId      String
  firmId      String?
  question    String   @db.Text
  /// KnowledgeCitation ids the user selected as input facts.
  citationIds Json
  /// Snapshot of the selected fact statements at ask time.
  factsText   Json
  /// Normalized iApp deka results (dekaId, headnote, citedStatutes, sourceUrl).
  results     Json
  provider    String   @default("iapp")
  createdById String
  createdAt   DateTime @default(now())

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User @relation("LegalQueryCreator", fields: [createdById], references: [id])

  @@index([caseId, createdAt])
}

/// ร่างคำคู่ความจาก AI ตามสำนวนคดี — ทนายกดสั่งร่างเอง (AI is user-invoked only)
/// และต้องยืนยัน (APPROVED) ก่อนนำไปใช้จริง
model PleadingDraft {
  id           String              @id @default(uuid())
  firmId       String
  caseId       String
  kind         String
  instructions String?
  bodyText     String              @db.Text
  citations    Json                @default("[]")
  status       PleadingDraftStatus @default(DRAFT)
  documentId   String?
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  firm      Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User @relation("PleadingDraftCreator", fields: [createdById], references: [id])

  @@index([caseId, createdAt])
}

/// 07:30 Asia/Bangkok stuck-work brief for the firm owner (AI secretary). One per firm per Bangkok day.
model DailyBrief {
  id        String   @id @default(cuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  /// 'YYYY-MM-DD' in Asia/Bangkok
  date      String
  /// AI headline; null when the AI call failed
  summary   String?
  /// DailyBriefData
  data      Json
  model     String?
  createdAt DateTime @default(now())

  @@unique([firmId, date])
}

/// Errors from every firm, read only by the operator's /superadmin console.
model ErrorLog {
  id         String    @id @default(uuid())
  /// api = an HTTP request failed with 5xx; server = a Logger.error call (cron, mail, integrations); web = the browser
  source     String
  message    String    @db.Text
  stack      String?   @db.Text
  /// Nest logger context or exception class name
  context    String?
  method     String?
  path       String?
  statusCode Int?
  userId     String?
  firmId     String?
  userAgent  String?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
}
