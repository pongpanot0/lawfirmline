model Firm {
  id                    String             @id @default(uuid())
  name                  String
  slug                  String             @unique
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  subscriptionPlan      SubscriptionPlan?
  trialStartAt          DateTime           @default(now())
  trialEndAt            DateTime
  currentPeriodEnd      DateTime?
  /// Smallest "days before trial end" reminder already emailed (7, 1, 0); null = none yet.
  trialReminderSentDays Int?
  stripeSubscriptionId  String?            @unique
  stripeCustomerId      String?            @unique
  maxUsers              Int                @default(2)
  officeAddress         String             @default("Bangkok, Thailand")
  /// Prefix for auto Own Ref, e.g. TSBREF → TSBREF20260001
  ownRefPrefix          String             @default("TSBREF")
  /// SLA targets, e.g. { "caseUpdateDays": 14, "reviewDays": 3 }
  slaConfig             Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  members            FirmMember[]
  invitations        Invitation[]
  subscriptions      Subscription[]
  billingInvoices    BillingInvoice[]
  auditLogs          AuditLog[]
  cases              Case[]
  caseTypes          CaseType[]
  clients            Client[]
  pettyCashFund      PettyCashFund?
  cashAdvances       CashAdvance[]
  paperFileMovements PaperFileMovement[]
  intakes            Intake[]
  emailThreads       EmailThread[]
  mailboxConnections MailboxConnection[]
  emailTemplates     EmailTemplate[]
  playbookReleases   PlaybookRelease[]
  automationLogs     AutomationLog[]
  sops               Sop[]
  importBatches      DataImportBatch[]
  expenseClaims      ExpenseClaim[]
  invoices           Invoice[]
  conflictChecks     ConflictCheck[]
  cargoClaims        CargoClaim[]
  leaves             LeaveRequest[]
  invoicePayments    InvoicePayment[]
  pleadingDrafts     PleadingDraft[]
  notifications      Notification[]
  workflowTemplates  WorkflowTemplate[]
  workflowRuns       WorkflowRun[]
  deadlineRules      DeadlineRule[]
  dailyBriefs        DailyBrief[]
}

model FirmMember {
  id                         String   @id @default(uuid())
  firmId                     String
  userId                     String
  role                       FirmRole
  createdAt                  DateTime @default(now())
  taskWorkTypes              String[] @default([])
  /// เป้าชั่วโมงเรียกเก็บได้ต่อเดือน — ใช้ในแดชบอร์ดสำนักงาน
  monthlyBillableTargetHours Float?
  /// ค่าเริ่มต้นต่อชั่วโมงเมื่อบันทึกเวลา
  defaultHourlyRate          Float?

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([firmId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(uuid())
  firmId      String
  email       String
  role        FirmRole  @default(ASSISTANT)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())

  firm      Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invitedBy User @relation("SentInvitations", fields: [invitedById], references: [id])

  @@unique([firmId, email])
}

model Subscription {
  id                   String             @id @default(uuid())
  firmId               String
  plan                 SubscriptionPlan
  billingPeriod        BillingPeriod      @default(MONTHLY)
  status               SubscriptionStatus
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt])
}

model BillingInvoice {
  id               String               @id @default(uuid())
  firmId           String
  invoiceNumber    String               @unique
  plan             SubscriptionPlan
  billingPeriod    BillingPeriod        @default(MONTHLY)
  amount           Int
  currency         String               @default("THB")
  status           BillingPaymentStatus @default(PENDING)
  stripeInvoiceId  String?              @unique
  hostedInvoiceUrl String?
  paidAt           DateTime?
  periodStart      DateTime?
  periodEnd        DateTime?
  createdAt        DateTime             @default(now())

  firm     Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id               String               @id @default(uuid())
  billingInvoiceId String
  amount           Int
  status           BillingPaymentStatus
  stripeChargeId   String?
  failureCode      String?
  failureMessage   String?
  createdAt        DateTime             @default(now())

  billingInvoice BillingInvoice @relation(fields: [billingInvoiceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  firmId    String
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  firm Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([firmId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MfaPurpose {
  /// Confirming the user's own address before mfaEnabled flips to true.
  ENABLE
  /// A per-login challenge, issued after the password already checked out.
  LOGIN
}

/// A 6-digit email code, hashed at rest — brute-forceable in principle, so
/// `attempts` caps how many guesses a code accepts before it is dead either
/// way. Never store or log the plaintext code once it has been sent.
model MfaCode {
  id        String     @id @default(uuid())
  userId    String
  codeHash  String
  purpose   MfaPurpose
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// One row per issued refresh token. Access tokens stay stateless (never
/// checked against this table) — revocation takes effect the next time the
/// client calls /auth/refresh, within JWT_EXPIRES_IN of a revoke.
model Session {
  id         String    @id @default(uuid())
  userId     String
  jti        String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                     String             @id @default(uuid())
  email                  String             @unique
  passwordHash           String
  firstName              String
  lastName               String
  role                   Role
  aiCredits              Int                @default(100)
  lineUserId             String?            @unique
  lineLinkCode           String?            @unique
  lineLinkCodeExpiresAt  DateTime?
  lineConnectedAt        DateTime?
  /// Opt out of the evening "what do I have tomorrow" digest.
  dailyDigestEnabled     Boolean            @default(true)
  /// Email one-time-code MFA. Off by default — never flip without the owner
  /// of this account confirming a code first (see MfaService.confirmEnable).
  mfaEnabled             Boolean            @default(false)
  /// Personal email signature appended to case emails sent from the system.
  emailSignature         String?            @db.Text
  /// ใบอนุญาตทนายความ — เลขที่ ประเภท และวันหมดอายุ (ใช้เตือนต่ออายุ)
  lawyerLicenseNo        String?
  lawyerLicenseType      LawyerLicenseType?
  lawyerLicenseExpiresAt DateTime?          @db.Date
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  mfaCodes                   MfaCode[]
  sessions                   Session[]
  firmMembers                FirmMember[]
  sentInvitations            Invitation[]                 @relation("SentInvitations")
  sentPortalInvitations      ClientPortalInvite[]         @relation("SentPortalInvitations")
  passwordResetTokens        PasswordResetToken[]
  auditLogs                  AuditLog[]
  leadCases                  Case[]                       @relation("LeadLawyer")
  assignments                CaseAssignment[]
  assignedTasks              Task[]                       @relation("TaskAssignee")
  createdTasks               Task[]                       @relation("TaskCreator")
  reviewTasks                Task[]                       @relation("TaskReviewer")
  taskAttachments            TaskAttachment[]             @relation("TaskAttachmentUploader")
  taskComments               TaskComment[]                @relation("TaskCommentAuthor")
  documents                  Document[]
  timeEntries                TimeEntry[]
  createdInvoices            Invoice[]                    @relation("InvoiceCreator")
  collectionInvoices         Invoice[]                    @relation("InvoiceCollector")
  expenses                   Expense[]
  paidExpenses               Expense[]                    @relation("ExpensePaidBy")
  submittedExpenseClaims     ExpenseClaim[]               @relation("ExpenseClaimSubmitter")
  reviewedExpenseClaims      ExpenseClaim[]               @relation("ExpenseClaimReviewer")
  paidExpenseClaims          ExpenseClaim[]               @relation("ExpenseClaimPayer")
  cashAdvancesReceived       CashAdvance[]                @relation("CashAdvanceRecipient")
  cashAdvancesIssued         CashAdvance[]                @relation("CashAdvanceIssuer")
  knowledge                  CaseKnowledge[]              @relation("CaseKnowledgeCreator")
  legalQueries               LegalQuery[]                 @relation("LegalQueryCreator")
  reviewedKnowledge          CaseKnowledge[]              @relation("CaseKnowledgeReviewer")
  intakeAttachments          IntakeAttachment[]
  intakePrecedentAnalyses    IntakePrecedentAnalysis[]
  caseActivities             CaseActivity[]
  receivedIntakes            Intake[]                     @relation("IntakeReceiver")
  followUpIntakes            Intake[]                     @relation("IntakeFollowUpOwner")
  intakeFollowUps            IntakeFollowUp[]             @relation("IntakeFollowUpAuthor")
  intakeDocRequests          IntakeDocumentRequest[]      @relation("DocRequestAuthor")
  conflictChecks             ConflictCheck[]              @relation("ConflictChecker")
  assessedIntakes            Intake[]                     @relation("IntakeAssessor")
  createdClosingEmailDrafts  ClosingEmailDraft[]          @relation("ClosingEmailDraftCreator")
  approvedClosingEmailDrafts ClosingEmailDraft[]          @relation("ClosingEmailDraftApprover")
  insuranceClaims            InsuranceClaim[]
  followedTaskOnHolds        TaskOnHold[]                 @relation("TaskOnHoldFollower")
  createdTaskOnHolds         TaskOnHold[]                 @relation("TaskOnHoldCreator")
  taskLogsFrom               TaskAssignmentLog[]          @relation("TaskLogFrom")
  taskLogsTo                 TaskAssignmentLog[]          @relation("TaskLogTo")
  taskLogsPerformed          TaskAssignmentLog[]          @relation("TaskLogPerformer")
  observedTasks              TaskObserver[]               @relation("TaskObserver")
  addedObservations          TaskObserver[]               @relation("TaskObserverAddedBy")
  grantedContactCaseAccess   ContactCaseAccess[]          @relation("ContactCaseAccessGranted")
  revokedContactCaseAccess   ContactCaseAccess[]          @relation("ContactCaseAccessRevoked")
  publishedDocuments         DocumentPublication[]        @relation("DocumentPublicationPublished")
  unpublishedDocuments       DocumentPublication[]        @relation("DocumentPublicationUnpublished")
  caseMessages               CaseMessage[]
  createdDateSuggestions     DocumentDateSuggestion[]     @relation("DateSuggestionCreator")
  reviewedDateSuggestions    DocumentDateSuggestion[]     @relation("DateSuggestionReviewer")
  dailyDigestLogs            DailyDigestLog[]
  leaveRequests              LeaveRequest[]               @relation("LeaveRequestUser")
  decidedLeaveRequests       LeaveRequest[]               @relation("LeaveDecider")
  assignedEvents             CalendarEvent[]              @relation("EventAssignee")
  eventAssignments           CalendarEventAssignee[]      @relation("EventCoAssignee")
  organizedMeetings          CalendarEvent[]              @relation("EventMeetingOrganizer")
  deviceTokens               DeviceToken[]
  caseStatusLogs             CaseStatusLog[]
  sops                       Sop[]
  confirmedCargoClaims       CargoClaim[]                 @relation("CargoClaimConfirmer")
  recordedInvoicePayments    InvoicePayment[]             @relation("InvoicePaymentRecorder")
  createdPleadingDrafts      PleadingDraft[]              @relation("PleadingDraftCreator")
  caseComments               CaseComment[]
  notifications              Notification[]
  notificationPreferences    UserNotificationPreference[]
  mailboxConnections         MailboxConnection[]          @relation("MailboxConnectionOwner")
  emailTemplates             EmailTemplate[]              @relation("EmailTemplateCreator")
  writtenOffTimeEntries      TimeEntry[]                  @relation("TimeEntryWriteOff")
  writtenOffExpenses         Expense[]                    @relation("ExpenseWriteOff")
  licenseReminderLogs        LawyerLicenseReminderLog[]
  settledCashAdvances        CashAdvance[]                @relation("CashAdvanceSettler")
  heldPaperFiles             Case[]                       @relation("PaperFileHolder")
  paperFileMovementsHeld     PaperFileMovement[]          @relation("PaperFileMovementHolder")
  paperFileMovementsCreated  PaperFileMovement[]          @relation("PaperFileMovementCreator")
}

enum LawyerLicenseType {
  TWO_YEAR
  LIFETIME
}

/// หนึ่งแถวต่อ (ผู้ใช้, วันหมดอายุ, ช่วงเตือน) — กัน cron เตือนซ้ำ
model LawyerLicenseReminderLog {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime @db.Date
  milestone String
  sentAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, expiresAt, milestone])
}

enum PaperFileAction {
  CHECK_OUT
  CHECK_IN
  MOVE
}

/// ประวัติการเบิก/คืน/ย้ายแฟ้มคดีกระดาษ
model PaperFileMovement {
  id           String          @id @default(uuid())
  firmId       String
  caseId       String
  action       PaperFileAction
  holderUserId String?
  location     String?
  note         String?
  createdById  String
  createdAt    DateTime        @default(now())

  firm      Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case      Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  holder    User? @relation("PaperFileMovementHolder", fields: [holderUserId], references: [id], onDelete: SetNull)
  createdBy User  @relation("PaperFileMovementCreator", fields: [createdById], references: [id])

  @@index([firmId, caseId, createdAt])
}

/// What a staff notification is about — the unit a user mutes per channel.
enum NotificationCategory {
  TASK
  CASE
  COMMENT
  CALENDAR
  CLIENT
  BILLING
  LEAVE
  EMAIL
  DAILY_BRIEF
  LICENSE
}

/// One staff notification, kept as the in-app inbox. Written for every
/// recipient regardless of channel preferences: muting push or LINE stops the
/// interruption, never the record.
model Notification {
  id        String               @id @default(uuid())
  firmId    String
  userId    String
  category  NotificationCategory
  title     String
  body      String?
  /// Web path, also what the LINE link points at.
  path      String
  /// Mobile route the app opens on tap; null when the app has no screen for it.
  appPath   String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, firmId, createdAt])
  @@index([userId, firmId, readAt])
  @@index([createdAt])
}

/// A user's opt-out for one category. No row means every channel is on.
model UserNotificationPreference {
  id       String               @id @default(uuid())
  userId   String
  category NotificationCategory
  push     Boolean              @default(true)
  line     Boolean              @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

/// A mobile device's Expo push token. One row per device; a token moves to
/// whoever logged in on that device last, so a shared iPad never pushes a
/// previous user's cases.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CaseType {
  id                String   @id @default(uuid())
  firmId            String
  name              String
  description       String?
  fieldSchema       Json?
  /// หมวดเอกสารที่คดีประเภทนี้ต้องมี — `DocumentCategory[]` (ไม่ใช่ข้อความอิสระ
  /// เพื่อให้เทียบกับ `Document.category` ได้ตรง ๆ) ใช้เช็ค missing documents ต่อคดี
  requiredDocuments Json?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  firm          Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  cases         Case[]
  intakes       Intake[]
  templates     DocumentTemplate[]
  deadlineRules DeadlineRule[]

  @@unique([firmId, name])
}

model Client {
  id           String   @id @default(uuid())
  firmId       String
  name         String
  type         String?
  notes        String?
  /// ข้อมูลออกเอกสาร (ใบแจ้งหนี้/ใบเสร็จ/ใบเสนอราคา) — กรอกได้ทีหลัง ไม่บังคับ
  taxId        String?
  branch       String?
  address      String?
  billingEmail String?
  billingPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  firm                    Firm                     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  contacts                ClientContact[]
  cases                   Case[]
  intakes                 Intake[]
  portalIntakeSubmissions PortalIntakeSubmission[]
  caseCustomerRoles       CaseCustomer[]
  intakeCustomerRoles     IntakeCustomer[]
  additionalCaseRoles     CaseClient[]
  additionalIntakeRoles   IntakeClient[]
  billedInvoices          Invoice[]                @relation("InvoiceBillTo")
  closingDraftRecipients  ClosingEmailDraft[]      @relation("ClosingDraftRecipient")
  annualReports           ClientAnnualReport[]
  caseParticipants        CaseParticipant[]

  @@index([firmId])
}

model ClientContact {
  id            String   @id @default(uuid())
  clientId      String
  name          String
  nickname      String?
  email         String?
  phone         String?
  position      String?
  isPrimary     Boolean  @default(false)
  portalEnabled Boolean  @default(false)
  /// Set by the contact after magic-link login; null means passwordless-only so far.
  passwordHash  String?
  dateAdded     DateTime @default(now())
  notes         String?

  lineUserId            String?   @unique
  lineLinkCode          String?   @unique
  lineLinkCodeExpiresAt DateTime?
  lineConnectedAt       DateTime?

  lastSeenMessagesAt DateTime?

  client                  Client                          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  loginTokens             ClientPortalLoginToken[]
  portalIntakeSubmissions PortalIntakeSubmission[]
  caseAccess              ContactCaseAccess[]
  notificationPreferences ContactNotificationPreference[]
  caseMessages            CaseMessage[]
  portalInvites           ClientPortalInvite[]
  caseCustomers           CaseCustomer[]                  @relation("CaseCustomerContact")
  intakeCustomers         IntakeCustomer[]                @relation("IntakeCustomerContact")
  uploadedDocuments       Document[]

  @@index([clientId])
}

/// Approved annual snapshot, shared only with named portal contacts.
model ClientAnnualReport {
  id                  String    @id @default(uuid())
  firmId              String
  clientId            String
  year                Int
  audience            String
  snapshot            Json
  fingerprint         String
  recipientContactIds String[]  @default([])
  publishedById       String
  publishedAt         DateTime  @default(now())
  revokedAt           DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([firmId, clientId, year])
  @@index([recipientContactIds], type: Gin)
}

model ClientPortalLoginToken {
  id              String    @id @default(uuid())
  clientContactId String
  token           String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  clientContact ClientContact @relation(fields: [clientContactId], references: [id], onDelete: Cascade)

  @@index([clientContactId])
}

/// Shared Thai court catalog — not scoped to a firm.
model Court {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Case {
  id                   String      @id @default(uuid())
  firmId               String
  ownRef               String
  customerRef          String?
  folderId             String
  title                String
  description          String?
  status               CaseStatus  @default(OPEN)
  stage                CaseStage   @default(PRE_LITIGATION)
  stageChangedAt       DateTime    @default(now())
  /// ขั้นล่าสุดที่ผู้ใช้จัดการงานแนะนำจาก playbook แล้ว (สร้างหรือข้าม) — ≠ stage → หน้าคดีเสนองานของขั้นนั้น
  stageTasksHandledFor CaseStage?
  outcome              CaseOutcome @default(IN_PROGRESS)
  clientId             String?
  clientName           String?
  /// ฝ่ายเรา — โจทก์หรือจำเลย ให้ AI และทีมรู้มุมที่ต้องทำงาน
  partyRole            PartyRole?
  courtName            String?
  courtLevel           CourtLevel?
  blackCaseNumber      String?
  redCaseNumber        String?
  customFields         Json?
  caseTypeId           String?
  /// เอกสารที่ทีมติ๊กเองว่า "มีแล้ว" (ค่าหมวดหรือข้อความอิสระจาก CaseType.requiredDocuments)
  /// แยกจากการตรวจจับอัตโนมัติจาก Document.category เพราะเอกสารข้อความอิสระเทียบอัตโนมัติไม่ได้
  confirmedDocuments   String[]    @default([])
  subType              String?
  claimedAmount        Float?
  estimatedFee         Float?
  actualFee            Float?
  limitationDeadline   DateTime?
  /// event "ครบอายุความ" ที่ระบบดูแลให้ (ดู common/limitation-reminder.ts)
  limitationEventId    String?
  referralSource       String?
  intakeId             String?     @unique
  closingSummary       String?     @db.Text
  /// ลบแบบ soft — คดีที่ถูกลบจะถูกกรองออกจากทุก query ผ่าน CaseAccessService
  /// ไม่ลบจริงเพราะ relation ทั้ง 20 ตารางเป็น onDelete: Cascade กู้คืนไม่ได้
  deletedAt            DateTime?
  leadLawyerId         String
  openedAt             DateTime    @default(now())
  closedAt             DateTime?
  /// แฟ้มกระดาษ — ใครถืออยู่ และเก็บที่ไหน
  paperFileHolderId    String?
  paperFileLocation    String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  paperFileHolder        User?                     @relation("PaperFileHolder", fields: [paperFileHolderId], references: [id], onDelete: SetNull)
  paperFileMovements     PaperFileMovement[]
  firm                   Firm                      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client                 Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadLawyer             User                      @relation("LeadLawyer", fields: [leadLawyerId], references: [id])
  caseType               CaseType?                 @relation(fields: [caseTypeId], references: [id])
  intake                 Intake?                   @relation(fields: [intakeId], references: [id])
  assignments            CaseAssignment[]
  participants           CaseParticipant[]
  tasks                  Task[]
  documents              Document[]
  documentRequests       IntakeDocumentRequest[]
  calendarEvents         CalendarEvent[]
  activities             CaseActivity[]
  timeEntries            TimeEntry[]
  expenses               Expense[]
  invoices               Invoice[]
  knowledge              CaseKnowledge[]
  precedentAnalyses      IntakePrecedentAnalysis[]
  relatedIntakes         Intake[]                  @relation("CaseRelatedIntakes")
  dateSuggestions        DocumentDateSuggestion[]
  closingEmailDrafts     ClosingEmailDraft[]
  appliedPlaybooks       AppliedPlaybook[]
  insuranceClaim         InsuranceClaim?
  contactAccess          ContactCaseAccess[]
  messages               CaseMessage[]
  customers              CaseCustomer[]
  additionalClients      CaseClient[]
  chunks                 DocumentChunk[]
  legalQueries           LegalQuery[]
  statusLogs             CaseStatusLog[]
  cargoClaim             CargoClaim?
  pleadingDrafts         PleadingDraft[]
  portalIntakeSubmission PortalIntakeSubmission?
  comments               CaseComment[]
  workflowRuns           WorkflowRun[]
  proceedings            CaseProceeding[]
  conflictChecks         ConflictCheck[]
  emailThreads           EmailThread[]             @relation("CaseEmailThreads")
  externalLinks          CaseExternalLink[]

  @@unique([firmId, ownRef])
  @@unique([firmId, folderId])
  @@index([firmId])
  @@index([clientId])
  @@index([firmId, stage])
  @@index([paperFileHolderId])
}

model CaseComment {
  id               String   @id @default(uuid())
  caseId           String
  authorId         String
  body             String   @db.Text
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([authorId])
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  firmId      String
  name        String
  description String?
  /// WorkflowStepDefinition[] (packages/shared): { title, instructions?, role: FirmRole, durationDays: number (1-60), requiresReview?: boolean }
  steps       Json
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  runs WorkflowRun[]

  @@index([firmId, isActive])
}

model WorkflowRun {
  id          String            @id @default(uuid())
  firmId      String
  caseId      String
  templateId  String?
  name        String /// e.g. "แปลคำให้การพยาน — นาย ก."
  status      WorkflowRunStatus @default(ACTIVE)
  promisedAt  DateTime? /// date promised to the client, for "late by N days"
  createdById String
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  firm     Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case     Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tasks    Task[]

  @@index([firmId, status])
  @@index([caseId])
}

model Intake {
  id                    String              @id @default(uuid())
  firmId                String
  receivedById          String
  receivedDate          DateTime            @default(now())
  title                 String?
  referralType          ReferralType        @default(INDIVIDUAL)
  referralChannel       ReferralChannel     @default(WALK_IN)
  referralName          String?
  clientId              String?
  clientName            String?
  /// เลขอ้างอิงฝั่งลูกค้า — ติดไปที่ Case.customerRef ตอนแปลงเป็นคดี
  customerRef           String?
  /// ฝ่ายเรา — โจทก์หรือจำเลย ติดไปที่ Case.partyRole ตอนเปิดคดี
  partyRole             PartyRole?
  matterType            String?
  /// ประเภทคดีที่คาดว่าจะเป็น — เลือกได้ตั้งแต่รับเรื่อง เพื่อแนะนำ Playbook
  /// ก่อนแปลงเป็นคดีจริง; แปลงเป็นคดีแล้วยังเปลี่ยนได้อีกทีที่ Case.caseTypeId
  caseTypeId            String?
  /// Playbook ที่เลือกไว้ตั้งแต่รับเรื่อง (PlaybookRelease.id, ไม่บังคับผูก FK
  /// เหมือน PlaybookRelease.caseTypeId) — ใช้ preselect ตอนกด "แปลงเป็นคดี"
  /// แทนการเดาจาก caseTypeId อย่างเดียว ยังเปลี่ยนได้ตอนนั้นอีกที
  preferredPlaybookId   String?
  opposingParty         String?
  incidentDate          DateTime?
  /// งานประกัน: กรอกได้ตั้งแต่รับเรื่อง แล้วตามไปเปิดเคลมให้ตอนแปลงเป็นคดี
  insurerName           String?
  policyNumber          String?
  claimNumber           String?
  description           String?             @db.Text
  estimatedDamage       Float?
  contactName           String?
  requestedResponseDate DateTime?
  assignedUserIds       String[]            @default([])
  deadlineDate          DateTime?
  portalSubmissionId    String?             @unique
  status                IntakeStatus        @default(RECEIVED)
  stage                 IntakeStage         @default(NEW_INQUIRY)
  stageChangedAt        DateTime            @default(now())
  /// เวลาที่เข้าสถานะปัจจุบัน — ใช้คำนวณว่าค้างในขั้นนี้มากี่วัน (aging)
  statusChangedAt       DateTime            @default(now())
  /// ติดตามครั้งถัดไป: lead ที่เงียบต้องมีคนและวันกำกับ ไม่ใช่ปล่อยให้หาย
  nextFollowUpAt        DateTime?
  followUpOwnerId       String?
  lastFollowUpAt        DateTime?
  assessorId            String?
  assessedAt            DateTime?
  assessmentNotes       String?             @db.Text
  caseStrength          String?
  decision              IntakeDecision      @default(PENDING)
  decisionNotes         String?             @db.Text
  decidedAt             DateTime?
  clientDecision        String?
  preLitigationType     PreLitigationType   @default(GENERAL)
  preLitigationStatus   PreLitigationStatus @default(NOT_STARTED)
  preLitigationNotes    String?             @db.Text
  settlementOfferAmount Float?
  noticeIssuedAt        DateTime?
  noticeRecipient       String?
  noticeDeadline        DateTime?
  noticeResult          String?
  noticeContent         String?             @db.Text
  relatedCaseId         String?
  isOngoingElsewhere    Boolean             @default(false)
  externalCaseNumber    String?
  currentStageNote      String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  firm                   Firm                      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  receivedBy             User                      @relation("IntakeReceiver", fields: [receivedById], references: [id])
  assessor               User?                     @relation("IntakeAssessor", fields: [assessorId], references: [id])
  followUpOwner          User?                     @relation("IntakeFollowUpOwner", fields: [followUpOwnerId], references: [id])
  followUps              IntakeFollowUp[]
  conflictChecks         ConflictCheck[]
  documentRequests       IntakeDocumentRequest[]
  tasks                  Task[]
  client                 Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  caseType               CaseType?                 @relation(fields: [caseTypeId], references: [id], onDelete: SetNull)
  case                   Case?
  portalIntakeSubmission PortalIntakeSubmission?
  attachments            IntakeAttachment[]
  precedentAnalyses      IntakePrecedentAnalysis[]
  relatedCase            Case?                     @relation("CaseRelatedIntakes", fields: [relatedCaseId], references: [id])
  documents              Document[]
  emailThreads           EmailThread[]
  fieldProposals         IntakeFieldProposal[]
  customers              IntakeCustomer[]
  additionalClients      IntakeClient[]
  invoices               Invoice[]
  cargoClaim             CargoClaim?

  @@index([firmId])
  @@index([clientId])
  @@index([relatedCaseId])
  @@index([firmId, status, statusChangedAt])
  @@index([firmId, stage, stageChangedAt])
  @@index([nextFollowUpAt])
  @@index([caseTypeId])
}

/// ประวัติการติดตาม lead หนึ่งครั้ง — ทำไปแล้วอะไร และนัดติดตามรอบถัดไปเมื่อไร
model IntakeFollowUp {
  id          String    @id @default(uuid())
  intakeId    String
  note        String    @db.Text
  contacted   Boolean   @default(true)
  nextDueAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  intake    Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  createdBy User   @relation("IntakeFollowUpAuthor", fields: [createdById], references: [id])

  @@index([intakeId, createdAt])
}

/// เอกสารหนึ่งรายการที่ขอจากลูกความในขั้นรับเรื่อง
///
/// ต้องรู้ว่า "ขออะไรไปแล้ว ได้อะไรมาแล้ว ยังขาดอะไร" ก่อนออกหนังสือหรือเปิดคดี
/// — ไม่ใช่ไปพบว่าขาดเอกสารตอนที่ต้องยื่นแล้ว
model IntakeDocumentRequest {
  id            String           @id @default(uuid())
  intakeId      String?
  caseId        String?
  requestedFrom String?
  name          String
  /// เอกสารที่ไม่ required ขาดได้โดยไม่กั้นการออกหนังสือ
  required      Boolean          @default(true)
  status        DocRequestStatus @default(REQUESTED)
  note          String?
  dueDate       DateTime?
  /// ไฟล์ที่รับมาแล้ว ถ้าผูกไว้
  documentId    String?
  requestedAt   DateTime         @default(now())
  receivedAt    DateTime?
  createdById   String
  updatedAt     DateTime         @updatedAt

  intake    Intake?   @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy User      @relation("DocRequestAuthor", fields: [createdById], references: [id])

  @@index([intakeId, status])
  @@index([caseId, status])
}

/// ผลการตรวจผลประโยชน์ขัดกันหนึ่งครั้ง (conflict check) — เก็บทั้งคำค้น ผลที่
/// ระบบเจอ และคำตัดสินของทนาย เพราะสิ่งที่ต้องพิสูจน์ย้อนหลังได้คือ "ตรวจแล้ว
/// และตัดสินใจอย่างนี้" ไม่ใช่แค่ผลลัพธ์สุดท้าย
model ConflictCheck {
  id          String         @id @default(uuid())
  firmId      String
  intakeId    String?
  caseId      String?
  searchTerms String[]
  /// ผลที่ค้นเจอตอนนั้น (snapshot) — ข้อมูลต้นทางเปลี่ยนภายหลังได้
  matches     Json
  matchCount  Int            @default(0)
  result      ConflictResult @default(NEEDS_REVIEW)
  notes       String?        @db.Text
  checkedById String
  checkedAt   DateTime       @default(now())

  firm      Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  intake    Intake? @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  case      Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  checkedBy User    @relation("ConflictChecker", fields: [checkedById], references: [id])

  @@index([firmId, checkedAt])
  @@index([intakeId])
  @@index([caseId])
}

model IntakeAttachment {
  id           String   @id @default(uuid())
  intakeId     String
  filename     String
  storagePath  String
  mimeType     String
  uploadedById String
  createdAt    DateTime @default(now())

  intake     Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([intakeId])
}

model IntakePrecedentAnalysis {
  id              String         @id @default(uuid())
  intakeId        String?
  firmId          String?
  caseId          String?
  status          AnalysisStatus @default(PENDING)
  extractedFacts  Json
  searchQueries   Json
  precedents      Json
  documentSummary String?        @db.Text // AI plain-language summary of intake/docs events
  /// ข้อเท็จจริงเป็นข้อๆ (string[]) — โครงสร้างไว้แสดงเป็น list ไม่ใช่ prose
  factsList       Json?
  /// ไทม์ไลน์เหตุการณ์ ({date, event}[]) เรียงตามเวลา ตามที่เอกสารระบุ
  timeline        Json?
  summaryBullets  String         @db.Text
  noticeFacts     String         @db.Text
  creditsCost     Float
  createdById     String
  createdAt       DateTime       @default(now())
  errorMessage    String?        @db.Text

  intake    Intake? @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  case      Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([intakeId, createdAt])
  @@index([caseId])
  @@index([firmId, createdById, createdAt])
}

model CaseParticipant {
  id                         String          @id @default(uuid())
  caseId                     String
  name                       String
  nickname                   String?
  role                       ParticipantRole @default(OTHER)
  side                       ParticipantSide @default(OPPONENT)
  personType                 String?
  idNumber                   String?
  address                    String?
  phone                      String?
  email                      String?
  opposingLawyer             String?
  opposingInsurer            String?
  medicalLicenseNo           String?
  notes                      String?
  /// ลูกความในทะเบียน (ฝ่ายเรา) ที่คู่ความรายนี้คือคนเดียวกัน
  clientId                   String?
  /// ทนาย/ผู้แทนฝ่ายตรงข้าม → คู่ความที่เขาเป็นตัวแทน
  representedByParticipantId String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  case          Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client        Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  representedBy CaseParticipant?  @relation("ParticipantRepresentation", fields: [representedByParticipantId], references: [id], onDelete: SetNull)
  represents    CaseParticipant[] @relation("ParticipantRepresentation")

  @@index([caseId])
  @@index([clientId])
}

/// ศาลแต่ละชั้นของคดี — Case.blackCaseNumber/redCaseNumber/courtName/courtLevel เป็นสำเนาของชั้นปัจจุบัน
model CaseProceeding {
  id              String           @id @default(uuid())
  caseId          String
  courtLevel      CourtLevel
  courtName       String?
  blackCaseNumber String?
  redCaseNumber   String?
  filedAt         DateTime?
  judgmentAt      DateTime?
  judgmentOutcome JudgmentOutcome?
  judgmentAmount  Decimal?         @db.Decimal(15, 2)
  judgmentNote    String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, courtLevel])
}

model CaseActivity {
  id          String       @id @default(uuid())
  caseId      String
  title       String
  description String?
  activityAt  DateTime     @default(now())
  type        ActivityType @default(OTHER)
  /// Structured staff contact log; null for ordinary case activities.
  contactData Json?
  createdById String
  createdAt   DateTime     @default(now())

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([caseId, activityAt])
}

model CaseAssignment {
  id             String         @id @default(uuid())
  caseId         String
  userId         String
  assignmentType AssignmentType
  createdAt      DateTime       @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId, assignmentType])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskSize {
  S
  M
  L
}

enum TaskWorkType {
  TRANSCRIPTION
  DOCUMENTS
  DRAFTING
  RESEARCH
  COURT
  GENERAL
}

model Task {
  id                      String        @id @default(uuid())
  caseId                  String?
  title                   String
  description             String?
  status                  TaskStatus    @default(TODO)
  /// Immutable office SOP snapshot; old/general tasks have no routine requirements.
  routine                 Json?
  routineCompletedChecks  Int[]         @default([])
  /// A retry after a lost response returns the same created task.
  createRequestId         String?       @unique
  assigneeId              String?
  createdById             String
  dueDate                 DateTime?
  source                  TaskSource    @default(WEB)
  parentId                String?
  /// A confirmed AI follow-up keeps its source even if the comment is later removed.
  followUpSourceTaskId    String?
  followUpSourceCommentId String?       @unique
  followUpSourceQuote     String?       @db.Text
  priority                TaskPriority  @default(MEDIUM)
  labels                  String[]      @default([])
  /// งานประจำ: เมื่อปิดงาน ระบบสร้างงานรอบถัดไปให้อัตโนมัติ ครบกำหนด +N วัน
  recurrenceDays          Int?
  /// งานนี้เริ่มไม่ได้จนกว่างาน blocker จะเสร็จ (single blocker พอสำหรับ pipeline งานคดี)
  blockedById             String?
  /// Set on the transition to DONE; legacy tasks remain null.
  completedAt             DateTime?
  /// Explicit tenant for new tasks; older case/intake tasks retain their existing scope.
  firmId                  String?
  workType                TaskWorkType?
  /// ขนาดงานโดยประมาณ ใช้คิดแต้มภาระงาน (S=1 M=2 L=4)
  size                    TaskSize      @default(M)
  scheduledFor            DateTime?     @db.Date
  queuePosition           Int           @default(0)
  requiresReview          Boolean       @default(false)
  reviewerId              String?
  /// When the worker handed the task in for review (PENDING_REVIEW). The worker stays `assigneeId`.
  submittedAt             DateTime?
  /// Handoff is refused until at least one attachment exists.
  requiresAttachment      Boolean       @default(false)
  assignedAt              DateTime?
  acknowledgedAt          DateTime?
  planConfirmedAt         DateTime?
  workflowRunId           String?
  workflowStep            Int?
  workflowDurationDays    Int?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  case           Case?               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// งานของเรื่องรับเข้า — เปิดคดีแล้วถูกย้ายไปเป็นงานคดี (caseId แทน intakeId)
  intakeId       String?
  intake         Intake?             @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  blockedBy      Task?               @relation("TaskBlocks", fields: [blockedById], references: [id], onDelete: SetNull)
  blocks         Task[]              @relation("TaskBlocks")
  assignee       User?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy      User                @relation("TaskCreator", fields: [createdById], references: [id])
  reviewer       User?               @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  workflowRun    WorkflowRun?        @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  onHold         TaskOnHold?
  assignmentLogs TaskAssignmentLog[]
  parent         Task?               @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks       Task[]              @relation("TaskSubtasks")
  attachments    TaskAttachment[]
  comments       TaskComment[]
  observers      TaskObserver[]

  @@index([dueDate])
  @@index([assigneeId, status, dueDate])
  @@index([reviewerId, status])
  @@index([completedAt])
  @@index([parentId])
  @@index([intakeId])
  @@index([blockedById])
  @@index([firmId, assigneeId, queuePosition])
  @@index([scheduledFor])
  @@index([workflowRunId, workflowStep])
}

model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String
  filename     String
  storagePath  String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([taskId])
}

model TaskComment {
  id               String   @id @default(uuid())
  taskId           String
  authorId         String
  body             String   @db.Text
  kind             String   @default("COMMENT")
  /// Firm members tagged with @ in this comment (same contract as CaseComment.mentionedUserIds).
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

model TaskObserver {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  addedById String
  createdAt DateTime @default(now())

  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User @relation("TaskObserver", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User @relation("TaskObserverAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskAssignmentLog {
  id            String        @id @default(uuid())
  taskId        String
  action        TaskLogAction
  fromUserId    String?
  toUserId      String
  performedById String
  note          String?       @db.Text
  stageDueDate  DateTime?
  createdAt     DateTime      @default(now())

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUser    User? @relation("TaskLogFrom", fields: [fromUserId], references: [id])
  toUser      User  @relation("TaskLogTo", fields: [toUserId], references: [id])
  performedBy User  @relation("TaskLogPerformer", fields: [performedById], references: [id])

  @@index([taskId, createdAt])
}

model Document {
  id                  String           @id @default(uuid())
  caseId              String?
  intakeId            String?
  filename            String
  storagePath         String
  mimeType            String
  version             Int              @default(1)
  /// หมวดเอกสาร — enum ไม่ใช่ free text เพราะต้องกรอง/จัดกลุ่ม/ทำรายงานได้จริง
  /// สำนักงานกำหนดว่าคดีประเภทไหนต้องมีหมวดใดผ่าน `CaseType.requiredDocuments`
  category            DocumentCategory @default(OTHER)
  /// วันที่บนหน้าเอกสาร (ไม่ใช่วันอัปโหลด) — เอกสารศาลเรียงด้วยวันที่นี้
  documentDate        DateTime?
  tags                String[]         @default([])
  uploadedById        String?
  uploadedByContactId String?
  visibleToClient     Boolean          @default(false)
  /// ถาดงาน AI: ตั้งเมื่อผู้ใช้ "ข้าม" หรือ AI อ่านครบ (จับวัน + สรุป) — null = ยังรอในถาด
  aiTrayHandledAt     DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  case               Case?                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  intake             Intake?                    @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  uploadedBy         User?                      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByContact  ClientContact?             @relation(fields: [uploadedByContactId], references: [id], onDelete: SetNull)
  versions           DocumentVersion[]
  knowledge          CaseKnowledge[]
  knowledgeCitations KnowledgeCitation[]
  dateSuggestions    DocumentDateSuggestion[]
  publications       DocumentPublication[]
  officeLink         DocumentOfficeLink?
  chunks             DocumentChunk[]
  intakeRequests     IntakeDocumentRequest[]
  cargoRequirements  CargoDocumentRequirement[]

  @@index([intakeId])
  @@index([caseId, category])
}

model CargoClaim {
  id                      String            @id @default(uuid())
  firmId                  String
  intakeId                String?           @unique
  caseId                  String?           @unique
  playbookReleaseId       String?
  assuredName             String?
  shipperName             String?
  consigneeName           String?
  contractingCarrierName  String?
  actualCarrierName       String?
  origin                  String?
  destination             String?
  transportMode           String?
  transportDocumentNumber String?
  arrivalDate             DateTime?
  lossDate                DateTime?
  goodsDescription        String?           @db.Text
  movementTerm            String?
  damageDescription       String?           @db.Text
  damagedWeight           Float?
  weightUnit              String?
  claimAmount             Float?
  currency                String            @default("THB")
  applicableLaw           String?           @db.Text
  jurisdiction            String?           @db.Text
  liableParty             String?           @db.Text
  liabilityLimit          String?           @db.Text
  liabilityExclusion      String?           @db.Text
  timeBarPeriod           String?
  timeBarTriggerDate      DateTime?
  timeBarDeadline         DateTime?
  timeBarBasis            String?           @db.Text
  quantumNotes            String?           @db.Text
  recommendation          String?           @db.Text
  opinion                 String?           @db.Text
  reviewStatus            CargoReviewStatus @default(DRAFT)
  confirmedById           String?
  confirmedAt             DateTime?
