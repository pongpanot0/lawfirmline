generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LAWYER
}

enum FirmRole {
  OWNER
  SENIOR_LAWYER
  LAWYER
  ASSISTANT
}

enum SubscriptionPlan {
  SOLO
  FIRM
  PROFESSIONAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingPaymentStatus {
  PENDING
  PAID
  FAILED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum CourtLevel {
  TRIAL
  APPEAL
  SUPREME
}

/// ขั้นตอนของคดีในกระบวนพิจารณา — แยกจาก `CaseStatus` ที่บอกเพียงว่างานยัง
/// เดินอยู่หรือไม่. สองเรื่องนี้ตอบคำถามต่างกัน: คดีที่ `PENDING` อยู่ขั้น
/// `HEARING` ก็ได้ หรืออยู่ขั้น `ENFORCEMENT` ก็ได้.
enum CaseStage {
  INTAKE_REVIEW
  FACT_GATHERING
  PRE_LITIGATION
  FILING
  MEDIATION
  HEARING
  AWAITING_JUDGMENT
  ENFORCEMENT
  CLOSING
}

enum PartyRole {
  PLAINTIFF
  DEFENDANT
}

enum CaseStatus {
  OPEN
  DRAFTING
  COURT_DATE
  IN_PROGRESS
  PENDING
  CLOSED
  ARCHIVED
}

enum CaseOutcome {
  WON
  LOST
  SETTLED
  /// ไกล่เกลี่ยสำเร็จ (ผ่านศาล/ศูนย์ไกล่เกลี่ย) — แยกจาก SETTLED ที่ตกลงกันเอง
  MEDIATED
  WITHDRAWN
  IN_PROGRESS
}

/// ขั้นตอนของงานรับเรื่อง — แยกจาก `IntakeStatus` ที่บอกผลลัพธ์ (รับ/ไม่รับ/
/// แปลงเป็นคดี/ไม่ตอบ). เรื่องที่ `RECEIVED` อยู่ขั้น `SCREENING` ก็ได้ หรือ
/// `WAITING_DOCUMENTS` ก็ได้ — คำถาม "ค้างอยู่ตรงไหน" ตอบด้วยอันนี้
enum IntakeStage {
  NEW_INQUIRY
  CONTACTED
  SCREENING
  CONFLICT_CHECK
  CONSULT_SCHEDULED
  CONSULTED
  WAITING_DOCUMENTS
  PRE_LITIGATION_NOTICE
  PROPOSAL
  CLOSED
}

/// สถานะเอกสารที่ขอจากลูกความก่อนเปิดคดี/ออกหนังสือ
enum DocRequestStatus {
  REQUESTED
  RECEIVED
  MISSING
  NOT_APPLICABLE
}

enum IntakeStatus {
  NO_RESPONSE
  RECEIVED
  ASSESSING
  ACCEPTED
  REJECTED
  CONVERTED
  CONSULTED
}

enum IntakeDecision {
  FILE_SUIT
  DO_NOT_FILE
  NEGOTIATE_FIRST
  SEND_NOTICE
  COMPLAIN_TO_AUTHORITY
  CONSULTATION_ONLY
  PENDING
}

enum PreLitigationType {
  GENERAL
  MEDICAL_CLAIM
  TRANSPORT
}

enum PreLitigationStatus {
  NOT_STARTED
  NOTICE_TO_SEND
  NOTICE_SENT
  UNDER_REVIEW
  REPORT_PREPARED
  OFFER_RECEIVED
  NEGOTIATING
  APPEAL_REVIEW
  READY_TO_FILE
  CLOSED_SETTLED
  CLOSED_NO_FILE
}

enum ReferralType {
  INDIVIDUAL
  LAWYER
  HOSPITAL
  COMPANY
  GOVERNMENT
  OTHER
}

enum ReferralChannel {
  WALK_IN
  PHONE
  EMAIL
  LINE
  REFERRAL
  OTHER
  PORTAL
}

enum NotificationChannel {
  EMAIL
  LINE
}

enum MessageSenderType {
  STAFF
  CONTACT
}

enum ParticipantRole {
  PLAINTIFF
  DEFENDANT
  PETITIONER
  RESPONDENT
  WITNESS
  EXPERT
  OPPOSING_LAWYER
  OPPOSING_INSURER
  OTHER
}

enum ParticipantSide {
  OURS
  OPPONENT
  NEUTRAL
}

enum InsuranceClaimStage {
  CLAIM_FILED
  DENIED_OR_PARTIAL
  DEMAND_SENT
  OIC_COMPLAINT
  SUIT_FILED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  NEEDS_REVISION
  DONE
}

enum TaskSource {
  WEB
  LINE
}

enum AssignmentType {
  BUDDY
}

enum TaskLogAction {
  ASSIGNED
  HANDED_OFF
  REJECTED
}

enum EventType {
  COURT_DATE
  CLIENT_MEETING
  DEADLINE
  OTHER
}

enum DateSuggestionStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

enum DateSuggestionSource {
  DOCUMENT
  RULE
}

enum DeadlineTrigger {
  COURT_DATE
  JUDGMENT
  ORDER_RECEIVED
  COMPLAINT_SERVED
}

enum DeadlineDayBasis {
  CALENDAR
  BUSINESS
}

enum ExpenseStatus {
  /// Saved by its author and not yet claimed — no money is committed.
  DRAFT
  PENDING
  APPROVED
  PAID
  REJECTED
}

/// A batch of expenses submitted together for owner review (one approve/reject).
enum ExpenseClaimStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

enum KnowledgeCategory {
  SUMMARY
  CONTRACT
  COURT_ORDER
  CORRESPONDENCE
  OTHER
}

enum AnalysisStatus {
  PENDING
  COMPLETE
  FAILED
}

/// หมวดเอกสารในคดี — คดีใหญ่มีเอกสารหลายร้อยชิ้น ค้นด้วยชื่อไฟล์ล้วนไม่ไหว
enum DocumentCategory {
  PLEADING
  EVIDENCE
  CONTRACT
  CORRESPONDENCE
  COURT_ORDER
  IDENTITY
  MEDICAL
  FINANCIAL
  INTERNAL
  OTHER
}

enum ConflictResult {
  CLEAR
  POTENTIAL_CONFLICT
  CONFLICT
  NEEDS_REVIEW
}

enum ActivityType {
  STATUS_CHANGE
  STAGE_CHANGE
  ASSIGNMENT
  DOCUMENT
  COURT_DATE
  CLIENT_MEETING
  FILING
  DEADLINE
  NOTE
  TASK
  OTHER
}

enum ClosingEmailDraftStatus {
  DRAFT
  APPROVED
}

model Firm {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  subscriptionPlan   SubscriptionPlan?
  trialStartAt       DateTime           @default(now())
  trialEndAt         DateTime
  currentPeriodEnd   DateTime?
  omiseCustomerId    String?
  maxUsers           Int                @default(2)
  officeAddress      String             @default("Bangkok, Thailand")
  /// Prefix for auto Own Ref, e.g. TSBREF → TSBREF20260001
  ownRefPrefix       String             @default("TSBREF")
  /// SLA targets, e.g. { "caseUpdateDays": 14, "reviewDays": 3 }
  slaConfig          Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members            FirmMember[]
  invitations        Invitation[]
  subscriptions      Subscription[]
  billingInvoices    BillingInvoice[]
  auditLogs          AuditLog[]
  cases              Case[]
  caseTypes          CaseType[]
  clients            Client[]
  pettyCashFund      PettyCashFund?
  cashAdvances       CashAdvance[]
  intakes            Intake[]
  emailThreads       EmailThread[]
  mailboxConnections MailboxConnection[]
  playbookReleases   PlaybookRelease[]
  automationLogs     AutomationLog[]
  sops               Sop[]
  importBatches      DataImportBatch[]
  expenseClaims      ExpenseClaim[]
  invoices           Invoice[]
  conflictChecks     ConflictCheck[]
}

model FirmMember {
  id        String   @id @default(uuid())
  firmId    String
  userId    String
  role      FirmRole
  createdAt DateTime @default(now())

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([firmId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(uuid())
  firmId      String
  email       String
  role        FirmRole  @default(ASSISTANT)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())

  firm      Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invitedBy User @relation("SentInvitations", fields: [invitedById], references: [id])

  @@unique([firmId, email])
}

model Subscription {
  id                  String             @id @default(uuid())
  firmId              String
  plan                SubscriptionPlan
  billingPeriod       BillingPeriod      @default(MONTHLY)
  status              SubscriptionStatus
  omiseSubscriptionId String?
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  canceledAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt])
}

model BillingInvoice {
  id            String               @id @default(uuid())
  firmId        String
  invoiceNumber String               @unique
  plan          SubscriptionPlan
  billingPeriod BillingPeriod        @default(MONTHLY)
  amount        Int
  currency      String               @default("THB")
  status        BillingPaymentStatus @default(PENDING)
  omiseChargeId String?
  paidAt        DateTime?
  periodStart   DateTime?
  periodEnd     DateTime?
  createdAt     DateTime             @default(now())

  firm     Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id               String               @id @default(uuid())
  billingInvoiceId String
  amount           Int
  status           BillingPaymentStatus
  omiseChargeId    String?
  failureCode      String?
  failureMessage   String?
  createdAt        DateTime             @default(now())

  billingInvoice BillingInvoice @relation(fields: [billingInvoiceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  firmId    String
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  firm Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([firmId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MfaPurpose {
  /// Confirming the user's own address before mfaEnabled flips to true.
  ENABLE
  /// A per-login challenge, issued after the password already checked out.
  LOGIN
}

/// A 6-digit email code, hashed at rest — brute-forceable in principle, so
/// `attempts` caps how many guesses a code accepts before it is dead either
/// way. Never store or log the plaintext code once it has been sent.
model MfaCode {
  id        String     @id @default(uuid())
  userId    String
  codeHash  String
  purpose   MfaPurpose
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// One row per issued refresh token. Access tokens stay stateless (never
/// checked against this table) — revocation takes effect the next time the
/// client calls /auth/refresh, within JWT_EXPIRES_IN of a revoke.
model Session {
  id         String    @id @default(uuid())
  userId     String
  jti        String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String
  firstName             String
  lastName              String
  role                  Role
  aiCredits             Int       @default(100)
  lineUserId            String?   @unique
  lineLinkCode          String?   @unique
  lineLinkCodeExpiresAt DateTime?
  lineConnectedAt       DateTime?
  /// Opt out of the evening "what do I have tomorrow" digest.
  dailyDigestEnabled    Boolean   @default(true)
  /// Email one-time-code MFA. Off by default — never flip without the owner
  /// of this account confirming a code first (see MfaService.confirmEnable).
  mfaEnabled            Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  mfaCodes                   MfaCode[]
  sessions                   Session[]
  firmMembers                FirmMember[]
  sentInvitations            Invitation[]              @relation("SentInvitations")
  sentPortalInvitations      ClientPortalInvite[]      @relation("SentPortalInvitations")
  passwordResetTokens        PasswordResetToken[]
  auditLogs                  AuditLog[]
  leadCases                  Case[]                    @relation("LeadLawyer")
  assignments                CaseAssignment[]
  assignedTasks              Task[]                    @relation("TaskAssignee")
  createdTasks               Task[]                    @relation("TaskCreator")
  taskAttachments            TaskAttachment[]          @relation("TaskAttachmentUploader")
  taskComments               TaskComment[]             @relation("TaskCommentAuthor")
  documents                  Document[]
  timeEntries                TimeEntry[]
  createdInvoices            Invoice[]                 @relation("InvoiceCreator")
  expenses                   Expense[]
  paidExpenses               Expense[]                 @relation("ExpensePaidBy")
  submittedExpenseClaims     ExpenseClaim[]            @relation("ExpenseClaimSubmitter")
  reviewedExpenseClaims      ExpenseClaim[]            @relation("ExpenseClaimReviewer")
  paidExpenseClaims          ExpenseClaim[]            @relation("ExpenseClaimPayer")
  cashAdvancesReceived       CashAdvance[]             @relation("CashAdvanceRecipient")
  cashAdvancesIssued         CashAdvance[]             @relation("CashAdvanceIssuer")
  knowledge                  CaseKnowledge[]           @relation("CaseKnowledgeCreator")
  legalQueries               LegalQuery[]              @relation("LegalQueryCreator")
  reviewedKnowledge          CaseKnowledge[]           @relation("CaseKnowledgeReviewer")
  intakeAttachments          IntakeAttachment[]
  intakePrecedentAnalyses    IntakePrecedentAnalysis[]
  caseActivities             CaseActivity[]
  receivedIntakes            Intake[]                  @relation("IntakeReceiver")
  followUpIntakes            Intake[]                  @relation("IntakeFollowUpOwner")
  intakeFollowUps            IntakeFollowUp[]          @relation("IntakeFollowUpAuthor")
  intakeDocRequests          IntakeDocumentRequest[]   @relation("DocRequestAuthor")
  conflictChecks             ConflictCheck[]           @relation("ConflictChecker")
  assessedIntakes            Intake[]                  @relation("IntakeAssessor")
  createdClosingEmailDrafts  ClosingEmailDraft[]       @relation("ClosingEmailDraftCreator")
  approvedClosingEmailDrafts ClosingEmailDraft[]       @relation("ClosingEmailDraftApprover")
  insuranceClaims            InsuranceClaim[]
  followedTaskOnHolds        TaskOnHold[]              @relation("TaskOnHoldFollower")
  createdTaskOnHolds         TaskOnHold[]              @relation("TaskOnHoldCreator")
  taskLogsFrom               TaskAssignmentLog[]       @relation("TaskLogFrom")
  taskLogsTo                 TaskAssignmentLog[]       @relation("TaskLogTo")
  taskLogsPerformed          TaskAssignmentLog[]       @relation("TaskLogPerformer")
  grantedContactCaseAccess   ContactCaseAccess[]       @relation("ContactCaseAccessGranted")
  revokedContactCaseAccess   ContactCaseAccess[]       @relation("ContactCaseAccessRevoked")
  publishedDocuments         DocumentPublication[]     @relation("DocumentPublicationPublished")
  unpublishedDocuments       DocumentPublication[]     @relation("DocumentPublicationUnpublished")
  caseMessages               CaseMessage[]
  createdDateSuggestions     DocumentDateSuggestion[]  @relation("DateSuggestionCreator")
  reviewedDateSuggestions    DocumentDateSuggestion[]  @relation("DateSuggestionReviewer")
  dailyDigestLogs            DailyDigestLog[]
  assignedEvents             CalendarEvent[]           @relation("EventAssignee")
  deviceTokens               DeviceToken[]
  caseStatusLogs             CaseStatusLog[]
  sops                       Sop[]
}

/// A mobile device's Expo push token. One row per device; a token moves to
/// whoever logged in on that device last, so a shared iPad never pushes a
/// previous user's cases.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CaseType {
  id          String   @id @default(uuid())
  firmId      String
  name        String
  description String?
  fieldSchema Json?
  /// หมวดเอกสารที่คดีประเภทนี้ต้องมี — `DocumentCategory[]` (ไม่ใช่ข้อความอิสระ
  /// เพื่อให้เทียบกับ `Document.category` ได้ตรง ๆ) ใช้เช็ค missing documents ต่อคดี
  requiredDocuments Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm          Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  cases         Case[]
  intakes       Intake[]
  templates     DocumentTemplate[]
  deadlineRules DeadlineRule[]

  @@unique([firmId, name])
}

model Client {
  id        String   @id @default(uuid())
  firmId    String
  name      String
  type      String?
  notes     String?
  /// ข้อมูลออกเอกสาร (ใบแจ้งหนี้/ใบเสร็จ/ใบเสนอราคา) — กรอกได้ทีหลัง ไม่บังคับ
  taxId        String?
  branch       String?
  address      String?
  billingEmail String?
  billingPhone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm                    Firm                     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  contacts                ClientContact[]
  cases                   Case[]
  intakes                 Intake[]
  portalIntakeSubmissions PortalIntakeSubmission[]
  caseCustomerRoles       CaseCustomer[]
  intakeCustomerRoles     IntakeCustomer[]
  additionalCaseRoles     CaseClient[]
  additionalIntakeRoles   IntakeClient[]
  billedInvoices          Invoice[]                @relation("InvoiceBillTo")

  @@index([firmId])
}

model ClientContact {
  id            String   @id @default(uuid())
  clientId      String
  name          String
  nickname      String?
  email         String?
  phone         String?
  position      String?
  isPrimary     Boolean  @default(false)
  portalEnabled Boolean  @default(false)
  /// Set by the contact after magic-link login; null means passwordless-only so far.
  passwordHash  String?
  dateAdded     DateTime @default(now())
  notes         String?

  lineUserId            String?   @unique
  lineLinkCode          String?   @unique
  lineLinkCodeExpiresAt DateTime?
  lineConnectedAt       DateTime?

  lastSeenMessagesAt DateTime?

  client                  Client                          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  loginTokens             ClientPortalLoginToken[]
  portalIntakeSubmissions PortalIntakeSubmission[]
  caseAccess              ContactCaseAccess[]
  notificationPreferences ContactNotificationPreference[]
  caseMessages            CaseMessage[]
  portalInvites           ClientPortalInvite[]
  caseCustomers           CaseCustomer[]                  @relation("CaseCustomerContact")
  intakeCustomers         IntakeCustomer[]                @relation("IntakeCustomerContact")

  @@index([clientId])
}

model ClientPortalLoginToken {
  id              String    @id @default(uuid())
  clientContactId String
  token           String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  clientContact ClientContact @relation(fields: [clientContactId], references: [id], onDelete: Cascade)

  @@index([clientContactId])
}

/// Shared Thai court catalog — not scoped to a firm.
model Court {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Case {
  id                 String      @id @default(uuid())
  firmId             String
  ownRef             String
  customerRef        String?
  folderId           String
  title              String
  description        String?
  status             CaseStatus  @default(OPEN)
  stage              CaseStage   @default(INTAKE_REVIEW)
  stageChangedAt     DateTime    @default(now())
  outcome            CaseOutcome @default(IN_PROGRESS)
  clientId           String?
  clientName         String?
  /// ฝ่ายเรา — โจทก์หรือจำเลย ให้ AI และทีมรู้มุมที่ต้องทำงาน
  partyRole          PartyRole?
  courtName          String?
  courtLevel         CourtLevel?
  blackCaseNumber    String?
  redCaseNumber      String?
  customFields       Json?
  caseTypeId         String?
  /// เอกสารที่ทีมติ๊กเองว่า "มีแล้ว" (ค่าหมวดหรือข้อความอิสระจาก CaseType.requiredDocuments)
  /// แยกจากการตรวจจับอัตโนมัติจาก Document.category เพราะเอกสารข้อความอิสระเทียบอัตโนมัติไม่ได้
  confirmedDocuments String[]    @default([])
  subType            String?
  claimedAmount      Float?
  estimatedFee       Float?
  actualFee          Float?
  limitationDeadline DateTime?
  referralSource     String?
  intakeId           String?     @unique
  closingSummary     String?     @db.Text
  leadLawyerId       String
  openedAt           DateTime    @default(now())
  closedAt           DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  firm               Firm                      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client             Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadLawyer         User                      @relation("LeadLawyer", fields: [leadLawyerId], references: [id])
  caseType           CaseType?                 @relation(fields: [caseTypeId], references: [id])
  intake             Intake?                   @relation(fields: [intakeId], references: [id])
  assignments        CaseAssignment[]
  participants       CaseParticipant[]
  tasks              Task[]
  documents          Document[]
  calendarEvents     CalendarEvent[]
  activities         CaseActivity[]
  timeEntries        TimeEntry[]
  expenses           Expense[]
  invoices           Invoice[]
  knowledge          CaseKnowledge[]
  precedentAnalyses  IntakePrecedentAnalysis[]
  relatedIntakes     Intake[]                  @relation("CaseRelatedIntakes")
  dateSuggestions    DocumentDateSuggestion[]
  closingEmailDrafts ClosingEmailDraft[]
  appliedPlaybooks   AppliedPlaybook[]
  insuranceClaim     InsuranceClaim?
  contactAccess      ContactCaseAccess[]
  messages           CaseMessage[]
  customers          CaseCustomer[]
  additionalClients  CaseClient[]
  chunks             DocumentChunk[]
  legalQueries       LegalQuery[]
  statusLogs         CaseStatusLog[]

  @@unique([firmId, ownRef])
  @@unique([firmId, folderId])
  @@index([firmId])
  @@index([clientId])
  @@index([firmId, stage])
}

model Intake {
  id                    String              @id @default(uuid())
  firmId                String
  receivedById          String
  receivedDate          DateTime            @default(now())
  title                 String?
  referralType          ReferralType        @default(INDIVIDUAL)
  referralChannel       ReferralChannel     @default(WALK_IN)
  referralName          String?
  clientId              String?
  clientName            String?
  /// เลขอ้างอิงฝั่งลูกค้า — ติดไปที่ Case.customerRef ตอนแปลงเป็นคดี
  customerRef           String?
  /// ฝ่ายเรา — โจทก์หรือจำเลย ติดไปที่ Case.partyRole ตอนเปิดคดี
  partyRole             PartyRole?
  matterType            String?
  /// ประเภทคดีที่คาดว่าจะเป็น — เลือกได้ตั้งแต่รับเรื่อง เพื่อแนะนำ Playbook
  /// ก่อนแปลงเป็นคดีจริง; แปลงเป็นคดีแล้วยังเปลี่ยนได้อีกทีที่ Case.caseTypeId
  caseTypeId            String?
  /// Playbook ที่เลือกไว้ตั้งแต่รับเรื่อง (PlaybookRelease.id, ไม่บังคับผูก FK
  /// เหมือน PlaybookRelease.caseTypeId) — ใช้ preselect ตอนกด "แปลงเป็นคดี"
  /// แทนการเดาจาก caseTypeId อย่างเดียว ยังเปลี่ยนได้ตอนนั้นอีกที
  preferredPlaybookId   String?
  opposingParty         String?
  incidentDate          DateTime?
  /// งานประกัน: กรอกได้ตั้งแต่รับเรื่อง แล้วตามไปเปิดเคลมให้ตอนแปลงเป็นคดี
  insurerName           String?
  policyNumber          String?
  claimNumber           String?
  description           String?             @db.Text
  estimatedDamage       Float?
  contactName           String?
  requestedResponseDate DateTime?
  assignedUserIds       String[]            @default([])
  deadlineDate          DateTime?
  portalSubmissionId    String?             @unique
  status                IntakeStatus        @default(RECEIVED)
  stage                 IntakeStage         @default(NEW_INQUIRY)
  stageChangedAt        DateTime            @default(now())
  /// เวลาที่เข้าสถานะปัจจุบัน — ใช้คำนวณว่าค้างในขั้นนี้มากี่วัน (aging)
  statusChangedAt       DateTime            @default(now())
  /// ติดตามครั้งถัดไป: lead ที่เงียบต้องมีคนและวันกำกับ ไม่ใช่ปล่อยให้หาย
  nextFollowUpAt        DateTime?
  followUpOwnerId       String?
  lastFollowUpAt        DateTime?
  assessorId            String?
  assessedAt            DateTime?
  assessmentNotes       String?             @db.Text
  caseStrength          String?
  decision              IntakeDecision      @default(PENDING)
  decisionNotes         String?             @db.Text
  decidedAt             DateTime?
  clientDecision        String?
  preLitigationType     PreLitigationType   @default(GENERAL)
  preLitigationStatus   PreLitigationStatus @default(NOT_STARTED)
  preLitigationNotes    String?             @db.Text
  settlementOfferAmount Float?
  noticeIssuedAt        DateTime?
  noticeRecipient       String?
  noticeDeadline        DateTime?
  noticeResult          String?
  noticeContent         String?             @db.Text
  relatedCaseId         String?
  isOngoingElsewhere    Boolean             @default(false)
  externalCaseNumber    String?
  currentStageNote      String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  firm                   Firm                      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  receivedBy             User                      @relation("IntakeReceiver", fields: [receivedById], references: [id])
  assessor               User?                     @relation("IntakeAssessor", fields: [assessorId], references: [id])
  followUpOwner          User?                     @relation("IntakeFollowUpOwner", fields: [followUpOwnerId], references: [id])
  followUps              IntakeFollowUp[]
  conflictChecks         ConflictCheck[]
  documentRequests       IntakeDocumentRequest[]
  tasks                  Task[]
  client                 Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  caseType               CaseType?                 @relation(fields: [caseTypeId], references: [id], onDelete: SetNull)
  case                   Case?
  portalIntakeSubmission PortalIntakeSubmission?
  attachments            IntakeAttachment[]
  precedentAnalyses      IntakePrecedentAnalysis[]
  relatedCase            Case?                     @relation("CaseRelatedIntakes", fields: [relatedCaseId], references: [id])
  documents              Document[]
  emailThreads           EmailThread[]
  fieldProposals         IntakeFieldProposal[]
  customers              IntakeCustomer[]
  additionalClients      IntakeClient[]
  invoices               Invoice[]

  @@index([firmId])
  @@index([clientId])
  @@index([relatedCaseId])
  @@index([firmId, status, statusChangedAt])
  @@index([firmId, stage, stageChangedAt])
  @@index([nextFollowUpAt])
  @@index([caseTypeId])
}

/// ประวัติการติดตาม lead หนึ่งครั้ง — ทำไปแล้วอะไร และนัดติดตามรอบถัดไปเมื่อไร
model IntakeFollowUp {
  id          String   @id @default(uuid())
  intakeId    String
  note        String   @db.Text
  contacted   Boolean  @default(true)
  nextDueAt   DateTime?
  createdById String
  createdAt   DateTime @default(now())

  intake    Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  createdBy User   @relation("IntakeFollowUpAuthor", fields: [createdById], references: [id])

  @@index([intakeId, createdAt])
}

/// เอกสารหนึ่งรายการที่ขอจากลูกความในขั้นรับเรื่อง
///
/// ต้องรู้ว่า "ขออะไรไปแล้ว ได้อะไรมาแล้ว ยังขาดอะไร" ก่อนออกหนังสือหรือเปิดคดี
/// — ไม่ใช่ไปพบว่าขาดเอกสารตอนที่ต้องยื่นแล้ว
model IntakeDocumentRequest {
  id          String           @id @default(uuid())
  intakeId    String
  name        String
  /// เอกสารที่ไม่ required ขาดได้โดยไม่กั้นการออกหนังสือ
  required    Boolean          @default(true)
  status      DocRequestStatus @default(REQUESTED)
  note        String?
  dueDate     DateTime?
  /// ไฟล์ที่รับมาแล้ว ถ้าผูกไว้
  documentId  String?
  requestedAt DateTime         @default(now())
  receivedAt  DateTime?
  createdById String
  updatedAt   DateTime         @updatedAt

  intake    Intake    @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy User      @relation("DocRequestAuthor", fields: [createdById], references: [id])

  @@index([intakeId, status])
}

/// ผลการตรวจผลประโยชน์ขัดกันหนึ่งครั้ง (conflict check) — เก็บทั้งคำค้น ผลที่
/// ระบบเจอ และคำตัดสินของทนาย เพราะสิ่งที่ต้องพิสูจน์ย้อนหลังได้คือ "ตรวจแล้ว
/// และตัดสินใจอย่างนี้" ไม่ใช่แค่ผลลัพธ์สุดท้าย
model ConflictCheck {
  id           String         @id @default(uuid())
  firmId       String
  intakeId     String?
  searchTerms  String[]
  /// ผลที่ค้นเจอตอนนั้น (snapshot) — ข้อมูลต้นทางเปลี่ยนภายหลังได้
  matches      Json
  matchCount   Int            @default(0)
  result       ConflictResult @default(NEEDS_REVIEW)
  notes        String?        @db.Text
  checkedById  String
  checkedAt    DateTime       @default(now())

  firm      Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  intake    Intake? @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  checkedBy User    @relation("ConflictChecker", fields: [checkedById], references: [id])

  @@index([firmId, checkedAt])
  @@index([intakeId])
}

model IntakeAttachment {
  id           String   @id @default(uuid())
  intakeId     String
  filename     String
  storagePath  String
  mimeType     String
  uploadedById String
  createdAt    DateTime @default(now())

  intake     Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([intakeId])
}

model IntakePrecedentAnalysis {
  id              String         @id @default(uuid())
  intakeId        String?
  firmId          String?
  caseId          String?
  status          AnalysisStatus @default(PENDING)
  extractedFacts  Json
  searchQueries   Json
  precedents      Json
  documentSummary String?        @db.Text // AI plain-language summary of intake/docs events
  /// ข้อเท็จจริงเป็นข้อๆ (string[]) — โครงสร้างไว้แสดงเป็น list ไม่ใช่ prose
  factsList       Json?
  /// ไทม์ไลน์เหตุการณ์ ({date, event}[]) เรียงตามเวลา ตามที่เอกสารระบุ
  timeline        Json?
  summaryBullets  String         @db.Text
  noticeFacts     String         @db.Text
  creditsCost     Float
  createdById     String
  createdAt       DateTime       @default(now())
  errorMessage    String?        @db.Text

  intake    Intake? @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  case      Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([intakeId, createdAt])
  @@index([caseId])
  @@index([firmId, createdById, createdAt])
}

model CaseParticipant {
  id               String          @id @default(uuid())
  caseId           String
  name             String
  nickname         String?
  role             ParticipantRole @default(OTHER)
  side             ParticipantSide @default(OPPONENT)
  personType       String?
  idNumber         String?
  address          String?
  phone            String?
  email            String?
  opposingLawyer   String?
  opposingInsurer  String?
  medicalLicenseNo String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CaseActivity {
  id          String       @id @default(uuid())
  caseId      String
  title       String
  description String?
  activityAt  DateTime     @default(now())
  type        ActivityType @default(OTHER)
  createdById String
  createdAt   DateTime     @default(now())

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([caseId, activityAt])
}

model CaseAssignment {
  id             String         @id @default(uuid())
  caseId         String
  userId         String
  assignmentType AssignmentType
  createdAt      DateTime       @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId, assignmentType])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(uuid())
  caseId      String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  source      TaskSource   @default(WEB)
  parentId    String?
  priority    TaskPriority @default(MEDIUM)
  labels      String[]     @default([])
  /// งานประจำ: เมื่อปิดงาน ระบบสร้างงานรอบถัดไปให้อัตโนมัติ ครบกำหนด +N วัน
  recurrenceDays Int?
  /// งานนี้เริ่มไม่ได้จนกว่างาน blocker จะเสร็จ (single blocker พอสำหรับ pipeline งานคดี)
  blockedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  case           Case?               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// งานของเรื่องรับเข้า — เปิดคดีแล้วถูกย้ายไปเป็นงานคดี (caseId แทน intakeId)
  intakeId       String?
  intake         Intake?             @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  blockedBy      Task?               @relation("TaskBlocks", fields: [blockedById], references: [id], onDelete: SetNull)
  blocks         Task[]              @relation("TaskBlocks")
  assignee       User?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy      User                @relation("TaskCreator", fields: [createdById], references: [id])
  onHold         TaskOnHold?
  assignmentLogs TaskAssignmentLog[]
  parent         Task?               @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks       Task[]              @relation("TaskSubtasks")
  attachments    TaskAttachment[]
  comments       TaskComment[]

  @@index([dueDate])
  @@index([assigneeId, status, dueDate])
  @@index([parentId])
  @@index([intakeId])
  @@index([blockedById])
}

model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String
  filename     String
  storagePath  String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

model TaskAssignmentLog {
  id            String        @id @default(uuid())
  taskId        String
  action        TaskLogAction
  fromUserId    String?
  toUserId      String
  performedById String
  note          String?       @db.Text
  stageDueDate  DateTime?
  createdAt     DateTime      @default(now())

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUser    User? @relation("TaskLogFrom", fields: [fromUserId], references: [id])
  toUser      User  @relation("TaskLogTo", fields: [toUserId], references: [id])
  performedBy User  @relation("TaskLogPerformer", fields: [performedById], references: [id])

  @@index([taskId, createdAt])
}

model Document {
  id              String   @id @default(uuid())
  caseId          String?
  intakeId        String?
  filename        String
  storagePath     String
  mimeType        String
  version         Int      @default(1)
  /// หมวดเอกสาร — enum ไม่ใช่ free text เพราะต้องกรอง/จัดกลุ่ม/ทำรายงานได้จริง
  /// สำนักงานกำหนดว่าคดีประเภทไหนต้องมีหมวดใดผ่าน `CaseType.requiredDocuments`
  category        DocumentCategory @default(OTHER)
  /// วันที่บนหน้าเอกสาร (ไม่ใช่วันอัปโหลด) — เอกสารศาลเรียงด้วยวันที่นี้
  documentDate    DateTime?
  tags            String[] @default([])
  uploadedById    String
  visibleToClient Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  case            Case?                    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  intake          Intake?                  @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  uploadedBy      User                     @relation(fields: [uploadedById], references: [id])
  versions           DocumentVersion[]
  knowledge          CaseKnowledge[]
  knowledgeCitations KnowledgeCitation[]
  dateSuggestions    DocumentDateSuggestion[]
  publications       DocumentPublication[]
  chunks             DocumentChunk[]
  intakeRequests     IntakeDocumentRequest[]

  @@index([intakeId])
  @@index([caseId, category])
}

model DocumentVersion {
  id          String                @id @default(uuid())
  documentId  String
  version     Int
  storagePath String
  filename    String
  mimeType    String
  status      DocumentVersionStatus @default(DRAFT)
  notes       String?               @db.Text
  contentHash String?
  createdById String?
  createdAt   DateTime              @default(now())

  document     Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  publications DocumentPublication[]
  reviewRounds ReviewRound[]

  @@unique([documentId, version])
}

enum DocumentVersionStatus {
  DRAFT
  WAITING_REVIEW
  RETURNED_FOR_CHANGES
  APPROVED
  SUPERSEDED
}

model DocumentPublication {
  id                String    @id @default(uuid())
  documentId        String
  documentVersionId String
  publishedAt       DateTime  @default(now())
  publishedById     String
  unpublishedAt     DateTime?
  unpublishedById   String?
  title             String?
  summary           String?   @db.Text
  eventDate         DateTime?
  recipientContacts String[]  @default([])
  isInternal        Boolean   @default(false)

  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id])
  publishedBy     User            @relation("DocumentPublicationPublished", fields: [publishedById], references: [id])
  unpublishedBy   User?           @relation("DocumentPublicationUnpublished", fields: [unpublishedById], references: [id])

  @@index([documentId, publishedAt])
}

model CalendarEvent {
  id              String    @id @default(uuid())
  caseId          String
  /// Who is attending. Reminders go to this person; without one they fall back
  /// to the case's lead lawyer rather than everyone staffed on the case.
  assigneeId      String?
  title           String
  description     String?
  courtName       String?
  startAt         DateTime
  endAt           DateTime?
  type            EventType @default(OTHER)
  reminderMinutes Int[]     @default([4320, 1440, 60])
  travelLogId     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  case               Case                     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignee           User?                    @relation("EventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  travelLog          TravelLog?               @relation(fields: [travelLogId], references: [id])
  reminderLogs       ReminderLog[]
  dateSuggestion     DocumentDateSuggestion?
  triggeredDeadlines DocumentDateSuggestion[] @relation("DateSuggestionTrigger")
  expenses           Expense[]
  responsibility     EventResponsibility?
  courtDay           CourtDay?

  @@index([startAt])
  @@index([assigneeId])
}

model ReminderLog {
  id            String   @id @default(uuid())
  eventId       String
  sentAt        DateTime @default(now())
  channel       String   @default("console")
  minutesBefore Int

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, minutesBefore])
}

model TimeEntry {
  id          String   @id @default(uuid())
  caseId      String
  userId      String
  hours       Float
  rate        Float    @default(0)
  description String?
  date        DateTime @default(now())
  billable    Boolean  @default(true)
  /// ใบแจ้งหนี้ที่เก็บเงินรายการนี้ไปแล้ว — กันออกบิลซ้ำ
  invoiceId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  case    Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Expense {
  id             String        @id @default(uuid())
  caseId         String?
  userId         String
  /// Set when this line is part of a submitted claim round.
  claimId        String?
  amount         Float
  description    String
  category       String?
  expensePurpose String?
  status         ExpenseStatus @default(PENDING)
  date           DateTime      @default(now())
  /// The hearing this cost came from, when it was drafted off one — so a
  /// reimbursement can be traced back to the trip that caused it.
  sourceEventId  String?
  paidAt         DateTime?
  paidById       String?
  /// Set when this cost was covered out of a cash advance the owner already
  /// handed the claimant — the expense is recorded straight as PAID and never
  /// enters an ExpenseClaim, since there is nothing left to reimburse.
  paidFromAdvanceId String?
  /// Optional receipt photo uploaded with the claim.
  receiptFilename    String?
  /// false = สำนักงานออกเอง ไม่ผลักไปเก็บกับลูกค้า
  billable           Boolean       @default(true)
  /// ใบแจ้งหนี้ที่เก็บเงินรายการนี้ไปแล้ว — กันออกบิลซ้ำ
  invoiceId          String?
  receiptStoragePath String?
  receiptMimeType    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  case            Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  user            User           @relation(fields: [userId], references: [id])
  paidBy          User?          @relation("ExpensePaidBy", fields: [paidById], references: [id])
  sourceEvent     CalendarEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  claim           ExpenseClaim?  @relation(fields: [claimId], references: [id], onDelete: SetNull)
  paidFromAdvance CashAdvance?   @relation(fields: [paidFromAdvanceId], references: [id], onDelete: SetNull)

  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([sourceEventId])
  @@index([claimId])
  @@index([paidFromAdvanceId])
  @@index([invoiceId])
}

/// One reimbursement round: lawyer submits many draft lines; owner approves the batch.
model ExpenseClaim {
  id            String             @id @default(uuid())
  firmId        String
  submittedById String
  status        ExpenseClaimStatus @default(PENDING)
  submittedAt   DateTime           @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  paidAt        DateTime?
  paidById      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  submittedBy User     @relation("ExpenseClaimSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?    @relation("ExpenseClaimReviewer", fields: [reviewedById], references: [id])
  paidBy      User?    @relation("ExpenseClaimPayer", fields: [paidById], references: [id])
  expenses    Expense[]

  @@index([firmId, status])
  @@index([submittedById])
}

model PettyCashFund {
  id        String   @id @default(uuid())
  firmId    String   @unique
  balance   Float    @default(50000)
  updatedAt DateTime @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
}

/// A cash float the owner hands a lawyer/staff member up front (เงินยืมสำรองจ่าย)
/// so they can cover case costs without waiting on reimbursement. `remaining`
/// is drawn down as expenses are logged against it via Expense.paidFromAdvanceId —
/// those expenses skip the normal claim → approve → reimburse cycle since the
/// cash already changed hands.
model CashAdvance {
  id           String   @id @default(uuid())
  firmId       String
  userId       String
  amount       Float
  remaining    Float
  note         String?
  issuedById   String
  issuedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  firm     Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user     User      @relation("CashAdvanceRecipient", fields: [userId], references: [id])
  issuedBy User      @relation("CashAdvanceIssuer", fields: [issuedById], references: [id])
  expenses Expense[]

  @@index([firmId, userId])
}

model TravelLog {
  id              String   @id @default(uuid())
  origin          String
  destination     String
  distanceMeters  Int
  durationSeconds Int
  mapsUrl         String?
  createdAt       DateTime @default(now())

  calendarEvents CalendarEvent[]

  @@index([origin, destination, createdAt])
}

model CaseKnowledge {
  id           String            @id @default(uuid())
  caseId       String
  documentId   String?
  title        String
  summary      String            @db.Text
  category     KnowledgeCategory @default(SUMMARY)
  createdById  String
  createdAt    DateTime          @default(now())
  /// Set once a lawyer has checked the citations against the source and
  /// confirmed the summary is accurate — never set by the analysis itself.
  reviewedById String?
  reviewedAt   DateTime?
  /// Contradictions or gaps the AI noticed in the source documents, e.g.
  /// [{ "type": "CONFLICT" | "MISSING", "description": "..." }]. Advisory
  /// only — never blocks saving or reading the analysis.
  flags        Json?

  case       Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document   Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy  User                @relation("CaseKnowledgeCreator", fields: [createdById], references: [id])
  reviewedBy User?               @relation("CaseKnowledgeReviewer", fields: [reviewedById], references: [id])
  citations  KnowledgeCitation[]
}

/// A single fact from an AI analysis, pinned to the exact document, version
/// and (when available) page it came from, with the verbatim sentence it was
/// read from. Only ever created after the quote is confirmed to appear in the
/// extracted document text — a citation that cannot be found in the source is
/// dropped rather than stored, so every row here is checkable by a lawyer.
model KnowledgeCitation {
  id              String   @id @default(uuid())
  knowledgeId     String
  documentId      String
  documentVersion Int
  page            Int?
  /// The fact in the lawyer's own reading order, e.g. "ค่าเสียหายที่เรียกร้อง 500,000 บาท".
  statement       String   @db.Text
  /// The verbatim sentence `statement` was read from — always checked to
  /// appear in the extracted document text before this row is created.
  quote           String   @db.Text
  createdAt       DateTime @default(now())

  knowledge CaseKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  document  Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([knowledgeId])
}

model DocumentDateSuggestion {
  id              String               @id @default(uuid())
  caseId          String
  documentId      String?
  label           String
  suggestedDate   DateTime
  eventType       EventType            @default(DEADLINE)
  /// Only present for DOCUMENT suggestions — a rule-derived date has no quote.
  sourceExcerpt   String?              @db.Text
  source          DateSuggestionSource @default(DOCUMENT)
  /// For RULE suggestions: the rule and the event that started the clock.
  deadlineRuleId  String?
  triggerEventId  String?
  status          DateSuggestionStatus @default(PENDING)
  calendarEventId String?              @unique
  createdById     String
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  case          Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("DateSuggestionCreator", fields: [createdById], references: [id])
  reviewedBy    User?          @relation("DateSuggestionReviewer", fields: [reviewedById], references: [id])
  deadlineRule  DeadlineRule?  @relation(fields: [deadlineRuleId], references: [id], onDelete: SetNull)
  triggerEvent  CalendarEvent? @relation("DateSuggestionTrigger", fields: [triggerEventId], references: [id], onDelete: Cascade)

  @@unique([triggerEventId, deadlineRuleId])
  @@index([caseId, status])
}

/// Platform-wide procedural clock: "<offsetDays> days from <trigger>".
/// Rules never write to the calendar directly — they raise a
/// DocumentDateSuggestion for a lawyer to confirm.
/// caseTypeId is reserved for a future catalog; this pass keeps it null.
model DeadlineRule {
  id         String           @id @default(uuid())
  caseTypeId String?
  trigger    DeadlineTrigger
  label      String
  offsetDays Int
  dayBasis   DeadlineDayBasis @default(CALENDAR)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  caseType    CaseType?                @relation(fields: [caseTypeId], references: [id], onDelete: Cascade)
  suggestions DocumentDateSuggestion[]

  @@index([trigger, isActive])
}

/// Thai public holidays, used when a rule counts business days.
model PublicHoliday {
  id   String   @id @default(uuid())
  date DateTime @db.Date
  name String

  @@unique([date])
}

/// One row per user per Bangkok day, so a digest is never sent twice.
model DailyDigestLog {
  id         String   @id @default(uuid())
  userId     String
  /// The Bangkok calendar day the digest covered.
  digestDate DateTime @db.Date
  channel    String   @default("line")
  itemCount  Int      @default(0)
  sentAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, digestDate, channel])
}

model DocumentTemplate {
  id           String   @id @default(uuid())
  /// null = built-in template ที่ทุก firm ใช้ได้; มีค่า = template ของ firm นั้นเท่านั้น
  firmId       String?
  name         String
  description  String?
  templateBody String   @db.Text
  caseTypeId   String?
  createdAt    DateTime @default(now())

  caseType CaseType? @relation(fields: [caseTypeId], references: [id], onDelete: SetNull)

  @@index([firmId])
}

model Invoice {
  id            String        @id @default(uuid())
  firmId        String
  /// ใบแจ้งหนี้ออกได้โดยไม่มีคดี — จากเรื่องที่รับเข้ามา หรือออกเปล่าให้ลูกค้าดูก่อน
  caseId        String?
  intakeId      String?
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  totalAmount   Float         @default(0)
  issuedAt      DateTime?
  dueAt         DateTime?
  createdById   String
  billToCustomerId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  firm          Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case          Case?             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  intake        Intake?           @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  createdBy     User              @relation("InvoiceCreator", fields: [createdById], references: [id])
  timeEntries   TimeEntry[]
  expenses      Expense[]
  billToCustomer Client?          @relation("InvoiceBillTo", fields: [billToCustomerId], references: [id], onDelete: SetNull)
  lineItems     InvoiceLineItem[]

  @@index([firmId])
  @@index([caseId])
  @@index([intakeId])
  @@index([billToCustomerId])
}

/// ลูกค้า (ผู้ว่าจ้าง/ผู้จ่ายเงิน) ของคดี — ต่างจาก Case.clientId ซึ่งคือลูกความที่เราว่าความให้
model CaseCustomer {
  id           String   @id @default(uuid())
  caseId       String
  customerId   String
  sharePercent Float?
  isPrimary    Boolean  @default(false)
  note         String?
  /// คนติดต่อฝั่งลูกค้ารายนี้ — ใครคือคนที่คุยกับเรา
  contactId    String?
  createdAt    DateTime @default(now())

  case     Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  customer Client         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  ClientContact? @relation("CaseCustomerContact", fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([caseId, customerId])
  @@index([customerId])
}

/// ลูกค้า (ผู้ว่าจ้าง/ผู้จ่ายเงิน) ของเรื่องที่รับเข้ามา — คัดลอกไป CaseCustomer ตอนแปลงเป็นคดี
model IntakeCustomer {
  id           String   @id @default(uuid())
  intakeId     String
  customerId   String
  sharePercent Float?
  isPrimary    Boolean  @default(false)
  note         String?
  /// คนติดต่อฝั่งลูกค้ารายนี้ — ติดไป CaseCustomer.contactId ตอนเปิดคดี
  contactId    String?
  createdAt    DateTime @default(now())

  intake   Intake         @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  customer Client         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  ClientContact? @relation("IntakeCustomerContact", fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([intakeId, customerId])
  @@index([customerId])
}

/// ลูกความเพิ่มเติมของคดี (เกินคนที่ 1) — Case.clientId ยังเป็นลูกความหลักเหมือนเดิม
model CaseClient {
  id        String   @id @default(uuid())
  caseId    String
  clientId  String
  note      String?
  createdAt DateTime @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([caseId, clientId])
  @@index([clientId])
}

/// ลูกความเพิ่มเติมของเรื่องที่รับเข้ามา — คัดลอกไป CaseClient ตอนแปลงเป็นคดี
model IntakeClient {
  id        String   @id @default(uuid())
  intakeId  String
  clientId  String
  note      String?
  createdAt DateTime @default(now())

  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([intakeId, clientId])
  @@index([clientId])
}

model InvoiceLineItem {
  id          String @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float  @default(1)
  unitPrice   Float
  amount      Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ClosingEmailDraft {
  id                  String                  @id @default(uuid())
  caseId              String
  createdById         String
  subject             String
  bodyText            String                  @db.Text
  selectedActivityIds String[]                @default([])
  missingDataNotes    String[]                @default([])
  status              ClosingEmailDraftStatus @default(DRAFT)
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  case       Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy  User  @relation("ClosingEmailDraftCreator", fields: [createdById], references: [id])
  approvedBy User? @relation("ClosingEmailDraftApprover", fields: [approvedById], references: [id])

  @@index([caseId, createdAt])
}

model InsuranceClaim {
  id                   String              @id @default(uuid())
  caseId               String              @unique
  insurerName          String
  policyNumber         String?
  claimNumber          String?
  incidentDate         DateTime
  claimedDate          DateTime?
  denialReason         String?             @db.Text
  stage                InsuranceClaimStage @default(CLAIM_FILED)
  demandLetterSentAt   DateTime?
  demandLetterDeadline DateTime?
  oicComplaintNumber   String?
  oicComplaintDate     DateTime?
  oicOutcome           String?             @db.Text
  limitationEventId    String?
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([caseId])
}

enum OnHoldCategory {
  WAITING_CLIENT
  WAITING_COURT
  WAITING_DOCUMENT
  WAITING_INTERNAL_REVIEW
  WAITING_EXTERNAL
  OTHER
}

model TaskOnHold {
  id             String         @id @default(uuid())
  taskId         String         @unique
  category       OnHoldCategory @default(OTHER)
