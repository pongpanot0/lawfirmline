/// `HEARING` ก็ได้ หรืออยู่ขั้น `ENFORCEMENT` ก็ได้.
enum CaseStage {
  INTAKE_REVIEW
  FACT_GATHERING
  PRE_LITIGATION
  FILING
  ANSWER
  MEDIATION
  HEARING
  AWAITING_JUDGMENT
  ENFORCEMENT
  CLOSING
  APPEAL
  SUPREME
}

