generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LAWYER
}

enum FirmRole {
  OWNER
  ASSISTANT
}

enum SubscriptionPlan {
  SOLO
  FIRM
  PROFESSIONAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingPaymentStatus {
  PENDING
  PAID
  FAILED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum CourtLevel {
  TRIAL
  APPEAL
  SUPREME
}

enum CaseStatus {
  OPEN
  DRAFTING
  COURT_DATE
  IN_PROGRESS
  PENDING
  CLOSED
}

enum CaseOutcome {
  WON
  LOST
  SETTLED
  WITHDRAWN
  IN_PROGRESS
}

enum IntakeStatus {
  RECEIVED
  ASSESSING
  ACCEPTED
  REJECTED
  CONVERTED
}

enum IntakeDecision {
  FILE_SUIT
  DO_NOT_FILE
  NEGOTIATE_FIRST
  SEND_NOTICE
  COMPLAIN_TO_AUTHORITY
  PENDING
}

enum ReferralType {
  INDIVIDUAL
  LAWYER
  HOSPITAL
  COMPANY
  GOVERNMENT
  OTHER
}

enum ReferralChannel {
  WALK_IN
  PHONE
  EMAIL
  LINE
  REFERRAL
  OTHER
}

enum ParticipantRole {
  PLAINTIFF
  DEFENDANT
  PETITIONER
  RESPONDENT
  WITNESS
  EXPERT
  OPPOSING_LAWYER
  OPPOSING_INSURER
  OTHER
}

enum ParticipantSide {
  OURS
  OPPONENT
  NEUTRAL
}

enum InsuranceClaimStage {
  CLAIM_FILED
  DENIED_OR_PARTIAL
  DEMAND_SENT
  OIC_COMPLAINT
  SUIT_FILED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskSource {
  WEB
  LINE
}

enum AssignmentType {
  BUDDY
}

enum EventType {
  COURT_DATE
  CLIENT_MEETING
  DEADLINE
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

enum KnowledgeCategory {
  SUMMARY
  CONTRACT
  COURT_ORDER
  CORRESPONDENCE
  OTHER
}

enum ActivityType {
  COURT_DATE
  CLIENT_MEETING
  FILING
  DEADLINE
  NOTE
  OTHER
}

model Firm {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  subscriptionPlan   SubscriptionPlan?
  trialStartAt       DateTime           @default(now())
  trialEndAt         DateTime
  currentPeriodEnd   DateTime?
  omiseCustomerId    String?
  maxUsers           Int                @default(2)
  officeAddress      String             @default("Bangkok, Thailand")
  /// Prefix for auto Own Ref, e.g. TSBREF → TSBREF20260001
  ownRefPrefix       String             @default("TSBREF")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members          FirmMember[]
  invitations      Invitation[]
  subscriptions    Subscription[]
  billingInvoices  BillingInvoice[]
  auditLogs        AuditLog[]
  cases            Case[]
  caseTypes        CaseType[]
  clients          Client[]
  courts           Court[]
  pettyCashFund    PettyCashFund?
  intakes          Intake[]
}

model FirmMember {
  id        String   @id @default(uuid())
  firmId    String
  userId    String
  role      FirmRole
  createdAt DateTime @default(now())

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([firmId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(uuid())
  firmId      String
  email       String
  role        FirmRole  @default(ASSISTANT)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())

  firm    Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invitedBy User @relation("SentInvitations", fields: [invitedById], references: [id])

  @@unique([firmId, email])
}

model Subscription {
  id                   String             @id @default(uuid())
  firmId               String
  plan                 SubscriptionPlan
  billingPeriod        BillingPeriod      @default(MONTHLY)
  status               SubscriptionStatus
  omiseSubscriptionId  String?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt])
}

model BillingInvoice {
  id            String               @id @default(uuid())
  firmId        String
  invoiceNumber String               @unique
  plan          SubscriptionPlan
  billingPeriod BillingPeriod        @default(MONTHLY)
  amount        Int
  currency      String               @default("THB")
  status        BillingPaymentStatus @default(PENDING)
  omiseChargeId String?
  paidAt        DateTime?
  periodStart   DateTime?
  periodEnd     DateTime?
  createdAt     DateTime             @default(now())

  firm     Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id               String               @id @default(uuid())
  billingInvoiceId String
  amount           Int
  status           BillingPaymentStatus
  omiseChargeId    String?
  failureCode      String?
  failureMessage   String?
  createdAt        DateTime             @default(now())

  billingInvoice BillingInvoice @relation(fields: [billingInvoiceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  firmId    String
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  firm Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([firmId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String
  firstName             String
  lastName              String
  role                  Role
  aiCredits             Int       @default(100)
  lineUserId            String?   @unique
  lineLinkCode          String?   @unique
  lineLinkCodeExpiresAt DateTime?
  lineConnectedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  firmMembers         FirmMember[]
  sentInvitations     Invitation[]         @relation("SentInvitations")
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  leadCases           Case[]               @relation("LeadLawyer")
  assignments         CaseAssignment[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  documents           Document[]
  timeEntries         TimeEntry[]
  createdInvoices     Invoice[]            @relation("InvoiceCreator")
  expenses            Expense[]
  paidExpenses        Expense[]            @relation("ExpensePaidBy")
  knowledge           CaseKnowledge[]
  caseActivities      CaseActivity[]
  receivedIntakes     Intake[]             @relation("IntakeReceiver")
  assessedIntakes     Intake[]             @relation("IntakeAssessor")
  insuranceClaims     InsuranceClaim[]
}

model CaseType {
  id          String   @id @default(uuid())
  firmId      String
  name        String
  description String?
  fieldSchema Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm      Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  cases     Case[]
  templates DocumentTemplate[]

  @@unique([firmId, name])
}

model Client {
  id        String   @id @default(uuid())
  firmId    String
  name      String
  type      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm     Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  contacts ClientContact[]
  cases    Case[]
  intakes  Intake[]

  @@index([firmId])
}

model ClientContact {
  id            String   @id @default(uuid())
  clientId      String
  name          String
  nickname      String?
  email         String?
  phone         String?
  position      String?
  isPrimary     Boolean  @default(false)
  portalEnabled Boolean  @default(false)
  dateAdded     DateTime @default(now())
  notes         String?

  client      Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  loginTokens ClientPortalLoginToken[]

  @@index([clientId])
}

model ClientPortalLoginToken {
  id              String    @id @default(uuid())
  clientContactId String
  token           String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  clientContact ClientContact @relation(fields: [clientContactId], references: [id], onDelete: Cascade)

  @@index([clientContactId])
}

model Court {
  id        String   @id @default(uuid())
  firmId    String
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, name])
  @@index([firmId])
}

model Case {
  id              String      @id @default(uuid())
  firmId          String
  ownRef          String
  customerRef     String?
  folderId        String
  title           String
  description     String?
  status          CaseStatus  @default(OPEN)
  outcome         CaseOutcome @default(IN_PROGRESS)
  clientId        String?
  clientName      String?
  courtName       String?
  courtLevel      CourtLevel?
  blackCaseNumber String?
  redCaseNumber   String?
  customFields    Json?
  caseTypeId      String?
  subType         String?
  claimedAmount   Float?
  estimatedFee    Float?
  actualFee       Float?
  limitationDeadline DateTime?
  referralSource  String?
  intakeId        String?     @unique
  closingSummary  String?     @db.Text
  leadLawyerId    String
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  firm           Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client         Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadLawyer     User             @relation("LeadLawyer", fields: [leadLawyerId], references: [id])
  caseType       CaseType?        @relation(fields: [caseTypeId], references: [id])
  intake         Intake?          @relation(fields: [intakeId], references: [id])
  assignments    CaseAssignment[]
  participants   CaseParticipant[]
  tasks          Task[]
  documents      Document[]
  calendarEvents CalendarEvent[]
  activities     CaseActivity[]
  timeEntries    TimeEntry[]
  expenses       Expense[]
  invoices       Invoice[]
  knowledge      CaseKnowledge[]
  insuranceClaim InsuranceClaim?

  @@unique([firmId, ownRef])
  @@unique([firmId, folderId])
  @@index([firmId])
  @@index([clientId])
}

model Intake {
  id              String          @id @default(uuid())
  firmId          String
  receivedById    String
  receivedDate    DateTime        @default(now())
  title           String?
  referralType    ReferralType    @default(INDIVIDUAL)
  referralChannel ReferralChannel @default(WALK_IN)
  referralName    String?
  clientId        String?
  clientName      String?
  matterType      String?
  opposingParty   String?
  incidentDate    DateTime?
  description     String?         @db.Text
  estimatedDamage Float?
  assignedUserIds String[]        @default([])
  deadlineDate    DateTime?
  status          IntakeStatus    @default(RECEIVED)
  assessorId      String?
  assessedAt      DateTime?
  assessmentNotes String?         @db.Text
  caseStrength    String?
  decision        IntakeDecision  @default(PENDING)
  decisionNotes   String?         @db.Text
  decidedAt       DateTime?
  clientDecision  String?
  noticeIssuedAt  DateTime?
  noticeRecipient String?
  noticeDeadline  DateTime?
  noticeResult    String?
  noticeContent   String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  firm       Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  receivedBy User    @relation("IntakeReceiver", fields: [receivedById], references: [id])
  assessor   User?   @relation("IntakeAssessor", fields: [assessorId], references: [id])
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case       Case?

  @@index([firmId])
  @@index([clientId])
}

model CaseParticipant {
  id                  String          @id @default(uuid())
  caseId              String
  name                String
  nickname            String?
  role                ParticipantRole @default(OTHER)
  side                ParticipantSide @default(OPPONENT)
  personType          String?
  idNumber            String?
  address             String?
  phone               String?
  email               String?
  opposingLawyer      String?
  opposingInsurer     String?
  medicalLicenseNo    String?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CaseActivity {
  id          String       @id @default(uuid())
  caseId      String
  title       String
  description String?
  activityAt  DateTime     @default(now())
  type        ActivityType @default(OTHER)
  createdById String
  createdAt   DateTime     @default(now())

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([caseId, activityAt])
}

model CaseAssignment {
  id             String         @id @default(uuid())
  caseId         String
  userId         String
  assignmentType AssignmentType
  createdAt      DateTime       @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId, assignmentType])
}

model Task {
  id          String     @id @default(uuid())
  caseId      String?
  title       String
  description String?
  status      TaskStatus @default(TODO)
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  source      TaskSource @default(WEB)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  case      Case?  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignee  User?  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User   @relation("TaskCreator", fields: [createdById], references: [id])
}

model Document {
  id              String   @id @default(uuid())
  caseId          String
  filename        String
  storagePath     String
  mimeType        String
  version         Int      @default(1)
  uploadedById    String
  visibleToClient Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  case       Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User              @relation(fields: [uploadedById], references: [id])
  versions   DocumentVersion[]
  knowledge  CaseKnowledge[]
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  version     Int
  storagePath String
  filename    String
  mimeType    String
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

model CalendarEvent {
  id              String    @id @default(uuid())
  caseId          String
  title           String
  description     String?
  courtName       String?
  startAt         DateTime
  endAt           DateTime?
  type            EventType @default(OTHER)
  reminderMinutes Int[]     @default([4320, 1440, 60])
  travelLogId     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  case         Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  travelLog    TravelLog?    @relation(fields: [travelLogId], references: [id])
  reminderLogs ReminderLog[]
}

model ReminderLog {
  id            String   @id @default(uuid())
  eventId       String
  sentAt        DateTime @default(now())
  channel       String   @default("console")
  minutesBefore Int

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, minutesBefore])
}

model TimeEntry {
  id          String   @id @default(uuid())
  caseId      String
  userId      String
  hours       Float
  rate        Float    @default(0)
  description String?
  date        DateTime @default(now())
  billable    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Expense {
  id             String        @id @default(uuid())
  caseId         String?
  userId         String
  amount         Float
  description    String
  category       String?
  expensePurpose String?
  status         ExpenseStatus @default(PENDING)
  date           DateTime      @default(now())
  paidAt         DateTime?
  paidById       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  case   Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  user   User  @relation(fields: [userId], references: [id])
  paidBy User? @relation("ExpensePaidBy", fields: [paidById], references: [id])
}

model PettyCashFund {
  id        String   @id @default(uuid())
  firmId    String   @unique
  balance   Float    @default(50000)
  updatedAt DateTime @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
}

model TravelLog {
  id              String   @id @default(uuid())
  origin          String
  destination     String
  distanceMeters  Int
  durationSeconds Int
  mapsUrl         String?
  createdAt       DateTime @default(now())

  calendarEvents CalendarEvent[]

  @@index([origin, destination, createdAt])
}

model CaseKnowledge {
  id          String            @id @default(uuid())
  caseId      String
  documentId  String?
  title       String
  summary     String            @db.Text
  category    KnowledgeCategory @default(SUMMARY)
  createdById String
  createdAt   DateTime          @default(now())

  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy User      @relation(fields: [createdById], references: [id])
}

model DocumentTemplate {
  id           String   @id @default(uuid())
  name         String
  description  String?
  templateBody String   @db.Text
  caseTypeId   String?
  createdAt    DateTime @default(now())

  caseType CaseType? @relation(fields: [caseTypeId], references: [id], onDelete: SetNull)
}

model Invoice {
  id            String        @id @default(uuid())
  caseId        String
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  totalAmount   Float         @default(0)
  issuedAt      DateTime?
  dueAt         DateTime?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  case      Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User              @relation("InvoiceCreator", fields: [createdById], references: [id])
  lineItems InvoiceLineItem[]
}

model InvoiceLineItem {
  id          String @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float  @default(1)
  unitPrice   Float
  amount      Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InsuranceClaim {
  id                   String              @id @default(uuid())
  caseId               String              @unique
  insurerName          String
  policyNumber         String?
  claimNumber          String?
  incidentDate         DateTime
  claimedDate          DateTime?
  denialReason         String?             @db.Text
  stage                InsuranceClaimStage @default(CLAIM_FILED)
  demandLetterSentAt   DateTime?
  demandLetterDeadline DateTime?
  oicComplaintNumber   String?
  oicComplaintDate     DateTime?
  oicOutcome           String?             @db.Text
  limitationEventId    String?
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([caseId])
}
