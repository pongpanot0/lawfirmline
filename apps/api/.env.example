DATABASE_URL="postgresql://lawfirm:lawfirm@localhost:5433/lawfirm"
JWT_SECRET="dev-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production"
CLIENT_PORTAL_JWT_SECRET="dev-client-portal-secret-change-in-production"
# Local dev only — returns the client portal magic-link token directly in the
# request-link API response, so you can log in without configuring SendGrid.
# Must NEVER be set to "true" in production.
CLIENT_PORTAL_EXPOSE_DEV_TOKEN="true"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
UPLOAD_DIR="./uploads"
PORT=3001
# Comma-separated allowed frontend origins (required for production)
CORS_ORIGIN="http://localhost:3005"
HOST="0.0.0.0"

# Railway: link Postgres plugin and use its DATABASE_URL
# DATABASE_URL="${{Postgres.DATABASE_URL}}"
# CORS_ORIGIN="https://your-web-app.up.railway.app"

# Optional integrations
OPENAI_API_KEY=""
IAPP_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# SendGrid (team invitations)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
SENDGRID_FROM_NAME="LexFlow"
SENDGRID_SKIP_TLS_VERIFY="true"
APP_URL=""

# Web app base URL (used to build links in LINE notifications)
WEB_APP_URL="http://localhost:3000"

# LINE Messaging API (Official Account)
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
# Optional: long-lived channel access token from LINE Developers Console
LINE_CHANNEL_ACCESS_TOKEN=""
# Optional: comma-separated LINE user IDs for push delivery
LINE_PUSH_USER_IDS=""
# Public HTTPS origin LINE can fetch for imagemap assets (ngrok in local)
# LINE_ASSET_BASE_URL="https://your-tunnel.ngrok-free.dev"

# Stripe Billing — keys from https://dashboard.stripe.com/apikeys (sk_test_... for dev; never commit a real key)
STRIPE_SECRET_KEY="sk_test_xxxxxxxx"
# Webhook (Dashboard → Developers → Webhooks, or `stripe listen --forward-to localhost:3001/saas/webhooks/stripe`)
# POST https://your-api/saas/webhooks/stripe — events: checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxx"

# Outlook / Microsoft Graph integration (self-service mailbox connect)
# Register an app at https://entra.microsoft.com (App registrations) with
# redirect URI {API_PUBLIC_URL}/outlook/callback and delegated scopes:
#   offline_access User.Read Mail.Read Mail.ReadWrite Mail.ReadWrite.Shared Mail.Send
#   Calendars.ReadWrite Files.ReadWrite.All Sites.Read.All
# Must be the API's own public URL (not the web app's — that's APP_URL/WEB_APP_URL).
API_PUBLIC_URL="http://localhost:3011"
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT_ID="common"
# 64-char hex (32 bytes) — encrypts stored OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAILBOX_TOKEN_ENCRYPTION_KEY=""
# Public HTTPS URL Microsoft Graph can reach for webhook notifications
# (use ngrok or similar in local dev — Graph will not call localhost).
OUTLOOK_WEBHOOK_URL=""

# Emails allowed to edit data every firm shares (courts, public holidays, deadline rules). Unset = nobody.
PLATFORM_ADMIN_EMAILS=
