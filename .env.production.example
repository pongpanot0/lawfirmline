SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=LexFlow

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_MOCK=false

OPENAI_API_KEY=
IAPP_API_KEY=
GOOGLE_MAPS_API_KEY=
