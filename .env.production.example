# Copy to .env (same directory as docker-compose.prod.yml) and fill in real values.
# Generate random secrets with: openssl rand -hex 32

DOMAIN=yourdomain.com
# Same value as DOMAIN — used by API CORS + firm subdomain tenancy
# DNS A records → EC2 IP (once):
#   yourdomain.com
#   api.yourdomain.com
#   *.yourdomain.com          ← covers every firm subdomain automatically
# Caddy issues TLS per firm host on first visit (On-Demand), after API confirms the slug exists.

# ECR images (built by GitHub Actions, pulled on EC2 — arm64 for t4g)
# Registry: 905418334683.dkr.ecr.ap-southeast-7.amazonaws.com
ECR_REGISTRY=905418334683.dkr.ecr.ap-southeast-7.amazonaws.com
IMAGE_TAG=latest

# RDS Postgres connection string (include ?sslmode=require)
# Example: postgresql://USER:PASSWORD@xxx.ap-southeast-7.rds.amazonaws.com:5432/DBNAME?sslmode=require
DATABASE_URL=

# S3 uploads (omit to use local UPLOAD_DIR instead)
S3_BUCKET=samnuan-uploads-905418334683-ap-southeast-7-an
S3_REGION=ap-southeast-7
# EC2 IAM role is preferred. If running in Docker on EC2, set instance
# metadata hop limit to 2 so containers can reach IMDS:
#   aws ec2 modify-instance-metadata-options --instance-id i-xxx --http-put-response-hop-limit 2
UPLOAD_DIR=/data/uploads

JWT_SECRET=
JWT_REFRESH_SECRET=
CLIENT_PORTAL_JWT_SECRET=

# Optional integrations — leave blank to disable
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=LexFlow

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_MOCK=false

OPENAI_API_KEY=
IAPP_API_KEY=
GOOGLE_MAPS_API_KEY=
