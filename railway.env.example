# Railway environment templates (copy into each service in Railway dashboard)

## PostgreSQL (Railway plugin)
# Auto-provided when you add Postgres to the project:
# DATABASE_URL=postgresql://...

## API service
# Config file: railway.api.toml
#
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# JWT_SECRET=<generate-a-long-random-string>
# JWT_REFRESH_SECRET=<generate-another-long-random-string>
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# CORS_ORIGIN=https://<your-web-service>.up.railway.app
# UPLOAD_DIR=./uploads
# HOST=0.0.0.0
# PORT (auto-set by Railway — do not override)
#
# Optional:
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# OMISE_PUBLIC_KEY=
# OMISE_SECRET_KEY=
# OMISE_MOCK=true
# OPENAI_API_KEY=
# GOOGLE_MAPS_API_KEY=

## Web service
# Config file: railway.web.toml
#
# NEXT_PUBLIC_API_URL=https://<your-api-service>.up.railway.app
# ROOT_DOMAIN=samnaun.com
# NEXT_PUBLIC_ROOT_DOMAIN=samnaun.com
# PORT (auto-set by Railway — do not override)
#
# Important: NEXT_PUBLIC_API_URL must be set BEFORE the web service builds.

## First deploy — seed demo data (run once via Railway shell on API service)
# pnpm db:seed
